---
interface Props {
  number: string;
  title: string;
  centerLabel?: string;
  figure?: string;
  surface?: 'ink' | 'paper';
  seam?: 'to-paper' | 'to-ink' | 'soft' | 'none';
  class?: string;
  id?: string;
}

const {
  number,
  title,
  centerLabel,
  figure,
  surface = 'ink',
  seam = 'none',
  id,
  class: className,
} = Astro.props;
---

<section id={id} data-seam={seam} class:list={['v2-section', `v2-section--${surface}`, className]}>
  <div class="v2-section__inner" data-scroll-fade>
    <div class="v2-section__header">
      <span class="v2-section__num">§ {number} · {title}</span>
      {centerLabel && <span class="v2-section__center">{centerLabel}</span>}
      {figure && <span class="v2-section__fig">FIG. {figure}</span>}
    </div>
    <div class="v2-section__rule" aria-hidden="true"></div>
    <div class="v2-section__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .v2-section {
    width: 100%;
    min-height: 100svh;
    display: grid;
    align-items: center;
    scroll-snap-align: start;
    padding: var(--v2-section-padding-y-top) 0 var(--v2-section-padding-y-bottom);
  }

  .v2-section--ink {
    background: var(--ink);
    color: var(--fg-on-dark);
  }

  .v2-section--paper {
    background: var(--paper);
    color: var(--fg-on-paper);
  }

  .v2-section[data-seam="to-paper"] {
    border-top: 1px solid rgba(var(--v2-ink-rgb), 0.24);
    box-shadow:
      inset 0 30px 44px -42px rgba(var(--v2-ink-rgb), 0.58),
      0 -1px 0 rgba(var(--v2-paper-rgb), 0.08);
  }

  .v2-section[data-seam="to-ink"] {
    border-top: 1px solid rgba(var(--v2-paper-rgb), 0.13);
    box-shadow:
      inset 0 28px 48px -44px rgba(var(--v2-paper-rgb), 0.24),
      0 -18px 28px -26px rgba(0, 0, 0, 0.78);
  }

  .v2-section[data-seam="soft"] {
    border-top: 1px solid var(--rule-dark-soft);
  }

  .v2-section[data-seam="none"] {
    border-top: 0;
    box-shadow: none;
  }

  .v2-section__inner {
    width: 100%;
    max-width: var(--v2-max-width);
    margin: 0 auto;
    padding: 0 var(--v2-section-padding-x);
  }

  .v2-section__header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: 24px;
    padding-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .v2-section__num {
    grid-column: 1;
    justify-self: start;
    color: var(--fg-on-dark-mute);
  }

  .v2-section--paper .v2-section__num {
    color: var(--fg-on-paper-mute);
  }

  .v2-section__center {
    grid-column: 2;
    justify-self: center;
    color: var(--fg-on-dark-mute);
  }

  .v2-section--paper .v2-section__center {
    color: var(--fg-on-paper-mute);
  }

  .v2-section__fig {
    grid-column: 3;
    justify-self: end;
    color: var(--fg-on-dark-mute);
  }

  .v2-section--paper .v2-section__fig {
    color: var(--fg-on-paper-mute);
  }

  .v2-section__rule {
    height: 1px;
    background: var(--rule-dark);
    margin-bottom: 40px;
  }

  .v2-section--paper .v2-section__rule {
    background: var(--rule-paper);
  }

  @media (max-width: 720px) {
    .v2-section {
      min-height: auto;
      align-items: start;
      padding: var(--v2-section-padding-y-top) 0 var(--v2-section-padding-y-bottom);
    }

    .v2-section__rule {
      margin-bottom: 24px;
    }

    .v2-section__center {
      display: none;
    }
  }
</style>
