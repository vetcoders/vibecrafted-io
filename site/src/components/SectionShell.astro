---
interface Props {
  number: string;
  title: string;
  centerLabel?: string;
  figure?: string;
  surface?: 'ink' | 'paper';
  seam?: 'to-paper' | 'to-ink' | 'soft' | 'none';
  class?: string;
  id?: string;
}

const {
  number,
  title,
  centerLabel,
  figure,
  surface = 'ink',
  seam = 'none',
  id,
  class: className,
} = Astro.props;
---

<section id={id} data-seam={seam} class:list={['v2-section', `v2-section--${surface}`, className]}>
  <div class="v2-section__inner" data-scroll-fade>
    <div class="v2-section__header">
      <span class="v2-section__num">{number} · {title}</span>
      {centerLabel && <span class="v2-section__center">{centerLabel}</span>}
      {figure && <span class="v2-section__fig">{figure.replace(/^FIG\.\s*/i, '')}</span>}
    </div>
    <div class="v2-section__rule" aria-hidden="true"></div>
    <div class="v2-section__body">
      <slot />
    </div>
  </div>
</section>

<style>
  /*
   * One screen = one viewport height. Padding stays generous (80px tokens);
   * the inner grid fills whatever is left. Content must shrink into that
   * frame — it does not grow the section, and padding is not the squeeze.
   */
  .v2-section {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    box-sizing: border-box;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    align-content: stretch;
    padding: var(--v2-section-padding-y-top) 0 var(--v2-section-padding-y-bottom);
    overflow: hidden;
  }

  .v2-section--ink {
    background: var(--ink);
    color: var(--fg-on-dark);
  }

  .v2-section--paper {
    background: var(--ink-soft);
    color: var(--fg-on-dark);
  }

  .v2-section[data-seam="to-paper"],
  .v2-section[data-seam="to-ink"],
  .v2-section[data-seam="soft"] {
    border-top: 1px solid var(--rule-dark);
  }

  .v2-section[data-seam="none"] {
    border-top: 0;
  }

  .v2-section__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
    max-width: var(--v2-max-width);
    margin: 0 auto;
    padding: 0 var(--v2-section-padding-x);
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    container-type: size;
  }

  .v2-section__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-on-dark-mute);
  }

  .v2-section__num,
  .v2-section__center,
  .v2-section__fig {
    color: var(--fg-on-dark-mute);
  }

  .v2-section__fig {
    font-variant-numeric: tabular-nums;
  }

  .v2-section__rule {
    height: 1px;
    background: var(--rule-dark);
    margin-bottom: 28px;
  }

  .v2-section__body {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .v2-section__body > :not(.v2-section__footer) {
    flex: 1 1 0;
    min-height: 0;
  }

  .v2-section__body > .v2-section__footer {
    flex: 0 0 auto;
  }

  @media print, (max-aspect-ratio: 1/3) {
    .v2-section {
      height: auto;
      max-height: none;
      overflow: visible;
    }
  }

  @media (max-width: 720px) {
    .v2-section {
      height: auto;
      max-height: none;
      min-height: 100dvh;
      overflow: visible;
      align-content: start;
    }

    .v2-section__rule {
      margin-bottom: 24px;
    }

    .v2-section__center,
    .v2-section__fig {
      display: none;
    }
  }
</style>
