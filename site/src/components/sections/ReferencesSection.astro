---
import { getTranslations, type Lang } from '../../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.references;
const dialogId = `reference-modal-${lang}`;
---
<section class="references-section" id="references">
    <div class="container fade-up" data-reference-links>
        <div class="section-label">{section.label}</div>
        <h2 class="section-title">{section.title}</h2>
        <p class="section-sub">{section.sub}</p>
        <ol class="references-list">
            {section.items.map((item) => {
                const links = 'links' in item ? item.links : undefined;

                return (
                    <li class="reference-item">
                        <p class="reference-citation"><Fragment set:html={item.citationHtml} /></p>
                        <p class="reference-note">{item.note}</p>
                        {links && (
                            <p class="reference-links">
                                {links.map((link) => (
                                    <a
                                        class="reference-link"
                                        href={link.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        data-reference-trigger
                                        data-reference-label={link.label}
                                    >
                                        {link.label}
                                    </a>
                                ))}
                            </p>
                        )}
                    </li>
                );
            })}
        </ol>

        <dialog class="reference-dialog" data-reference-dialog aria-labelledby={dialogId}>
            <div class="reference-dialog__panel">
                <p class="reference-dialog__eyebrow">{section.modal.eyebrow}</p>
                <h3 class="reference-dialog__title" id={dialogId}>{section.modal.title}</h3>
                <p class="reference-dialog__target">
                    <span class="reference-dialog__target-label">{section.modal.sourceLabel}</span>
                    <span data-reference-target>Source</span>
                </p>
                <div class="reference-dialog__actions">
                    <button
                        class="reference-dialog__action reference-dialog__action--back"
                        data-hover={section.modal.backHover}
                        type="button"
                        value="cancel"
                        data-reference-close
                    >
                        {section.modal.backLabel}
                    </button>
                    <button
                        class="reference-dialog__action reference-dialog__action--open"
                        data-hover={section.modal.openHover}
                        type="button"
                        data-reference-open
                    >
                        {section.modal.openLabel}
                    </button>
                </div>
            </div>
        </dialog>
    </div>
</section>

<script is:inline>
    (() => {
        const bindReferenceDialogs = () => {
            document.querySelectorAll("[data-reference-links]").forEach((section) => {
                if (!(section instanceof HTMLElement) || section.dataset.referenceDialogBound === "true") {
                    return;
                }

                section.dataset.referenceDialogBound = "true";

                const dialog = section.querySelector("[data-reference-dialog]");
                const target = section.querySelector("[data-reference-target]");
                const openButton = section.querySelector("[data-reference-open]");
                const closeButton = section.querySelector("[data-reference-close]");

                if (
                    !(dialog instanceof HTMLDialogElement) ||
                    !(target instanceof HTMLElement) ||
                    !(openButton instanceof HTMLButtonElement) ||
                    !(closeButton instanceof HTMLButtonElement)
                ) {
                    return;
                }

                let pendingHref = "";

                const unlockBody = () => {
                    document.body.classList.remove("modal-open");
                };

                const openDialog = (trigger) => {
                    pendingHref = trigger.href;
                    target.textContent = trigger.dataset.referenceLabel || trigger.href;
                    if (!dialog.open) {
                        dialog.showModal();
                    }
                    document.body.classList.add("modal-open");
                };

                section.addEventListener("click", (event) => {
                    const source = event.target instanceof Element ? event.target.closest("[data-reference-trigger]") : null;
                    if (!(source instanceof HTMLAnchorElement)) {
                        return;
                    }

                    event.preventDefault();
                    openDialog(source);
                });

                closeButton.addEventListener("click", () => {
                    dialog.close("cancel");
                });

                openButton.addEventListener("click", () => {
                    if (!pendingHref) {
                        dialog.close("cancel");
                        return;
                    }

                    const outbound = document.createElement("a");
                    outbound.href = pendingHref;
                    outbound.target = "_blank";
                    outbound.rel = "noopener noreferrer";
                    outbound.click();
                    dialog.close("open");
                });

                dialog.addEventListener("close", () => {
                    pendingHref = "";
                    unlockBody();
                });

                dialog.addEventListener("cancel", unlockBody);

                dialog.addEventListener("click", (event) => {
                    const bounds = dialog.getBoundingClientRect();
                    const clickedInside =
                        bounds.top <= event.clientY &&
                        event.clientY <= bounds.bottom &&
                        bounds.left <= event.clientX &&
                        event.clientX <= bounds.right;

                    if (!clickedInside) {
                        dialog.close("dismiss");
                    }
                });
            });
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", bindReferenceDialogs, { once: true });
        } else {
            bindReferenceDialogs();
        }

        document.addEventListener("astro:page-load", bindReferenceDialogs);
    })();
</script>
