---
import { getTranslations, type Lang } from '../../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.references;
---
<section class="references-section" id="references">
    <div class="container fade-up">
        <div class="section-label">{section.label}</div>
        <h2 class="section-title">{section.title}</h2>
        <p class="section-sub">{section.sub}</p>
        <ol class="references-list">
            {section.items.map((item) => {
                const links = 'links' in item ? item.links : undefined;

                return (
                    <li class="reference-item">
                        <p class="reference-citation"><Fragment set:html={item.citationHtml} /></p>
                        <p class="reference-note">{item.note}</p>
                        {links && (
                            <p class="reference-links">
                                {links.map((link) => (
                                    <a href={link.href}>{link.label}</a>
                                ))}
                            </p>
                        )}
                    </li>
                );
            })}
        </ol>
    </div>
</section>
