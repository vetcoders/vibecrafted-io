---
// References section — server-side wrapper.
//
// Loads references content from the i18n collection and hands the typed
// data to the interactive Svelte client component. The actual UI (cards,
// confirmation modal, focus handling) lives in ReferencesSectionClient.svelte.
import { getEntry } from 'astro:content';
import type { Lang } from '../../lib/i18n';
import ReferencesSectionClient from './ReferencesSectionClient.svelte';

type ReferenceLink = { href: string; label: string };
type ReferenceItem = {
    citationHtml: string;
    note: string;
    links?: ReferenceLink[];
};
type ReferencesData = {
    label: string;
    title: string;
    sub: string;
    modal: {
        eyebrow: string;
        title: string;
        sourceLabel: string;
        backLabel: string;
        openLabel: string;
        backHover: string;
        openHover: string;
    };
    items: ReferenceItem[];
};

const { lang } = Astro.props as { lang: Lang };

const entry = await getEntry('i18n', `${lang}/references`);
if (!entry) {
    throw new Error(`References content not found for lang=${lang}`);
}
const data = entry.data as ReferencesData;
---
<ReferencesSectionClient client:load lang={lang} data={data} />
