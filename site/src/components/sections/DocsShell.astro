---
---
<div class="docs-shell">
    <slot />
</div>

<style is:global>
  :is(body.docs-page, html.subpage body) .shell {
    padding: var(--docs-shell-padding-block);
  }

  :is(body.docs-page, html.subpage body) section,
  :is(body.docs-page, html.subpage body) .view {
    display: block;
    min-height: auto;
    padding: 0 0 var(--space-xl);
    scroll-snap-align: none;
  }

  :is(body.docs-page, html.subpage body) .docs-shell {
    width: var(--docs-shell-width-expanded);
    margin: 0 auto;
    display: grid;
    gap: var(--docs-shell-gap-expanded);
  }

  :is(body.docs-page, html.subpage body) .docs-shell > section:not(.docs-hero) {
    display: block;
  }

  :is(body.docs-page, html.subpage body) .docs-shell > section.docs-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(13.75rem, 15.5rem);
    grid-template-areas:
      'label quote'
      'title actions'
      'lead actions';
    gap: clamp(0.8rem, 1.4vw, 1.05rem);
    align-items: start;
    max-width: none;
    padding: clamp(1.05rem, 1.7vw, 1.45rem);
    border: 1px solid var(--glass-panel-border);
    border-radius: var(--docs-hero-radius-expanded);
    background: var(--glass-panel-bg);
    backdrop-filter: var(--docs-hero-backdrop);
    -webkit-backdrop-filter: var(--docs-hero-backdrop);
    box-shadow: var(--docs-hero-shadow);
    overflow: hidden;
  }

  :is(body.docs-page, html.subpage body) .docs-hero > .section-label {
    grid-area: label;
    align-self: start;
    margin: 0;
  }

  :is(body.docs-page, html.subpage body) .docs-hero > .manifesto-title {
    grid-area: title;
    max-width: 10ch;
    margin-bottom: 0;
  }

  :is(body.docs-page, html.subpage body) .docs-hero > .manifesto-lead {
    grid-area: lead;
    max-width: 40rem;
    margin: 0;
    color: var(--docs-hero-lead-color);
  }

  :is(body.docs-page, html.subpage body) .docs-hero > .manifesto-quote {
    grid-area: quote;
    justify-self: end;
    align-self: start;
    max-width: 11.5rem;
    margin: 0;
    text-align: right;
    line-height: 1.4;
    font-size: clamp(0.94rem, 1.05vw, 1.04rem);
    color: var(--docs-hero-quote-color);
  }

  :is(body.docs-page, html.subpage body) .docs-hero > .manifesto-actions {
    grid-area: actions;
    display: grid;
    gap: var(--docs-actions-gap);
    width: min(100%, 14rem);
    justify-self: end;
    justify-items: stretch;
    align-self: end;
  }

  :is(body.docs-page, html.subpage body) .quickstart-hero-section--operations > .manifesto-title {
    max-width: 9.5ch;
  }

  :is(body.docs-page, html.subpage body) .docs-hero > .manifesto-actions .btn-solid,
  :is(body.docs-page, html.subpage body) .docs-hero > .manifesto-actions .btn-outline {
    width: 100%;
    text-align: center;
  }

  :is(body.docs-page, html.subpage body) :is(.docs-card, .faq-group, .resource-card) {
    display: grid;
    gap: var(--docs-card-gap);
    align-content: start;
    min-height: 100%;
  }

  :is(body.docs-page, html.subpage body) .docs-grid {
    display: grid;
    gap: var(--space-md);
  }

  :is(body.docs-page, html.subpage body) .docs-grid--steps {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
  }

  :is(body.docs-page, html.subpage body) .docs-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
    align-items: stretch;
  }

  :is(body.docs-page, html.subpage body) .faq-layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
    align-items: stretch;
  }

  :is(body.docs-page, html.subpage body) .faq-item summary {
    line-height: 1.35;
  }

  :is(body.docs-page, html.subpage body) .faq-item p,
  :is(body.docs-page, html.subpage body) .faq-item ul {
    line-height: 1.65;
  }

  :is(body.docs-page, html.subpage body) .docs-inline-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--docs-inline-links-gap);
    margin-top: 0;
    padding: var(--docs-inline-links-padding);
    align-items: stretch;
  }

  :is(body.docs-page, html.subpage body) .docs-inline-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--interactive-min-height);
    padding: var(--modal-link-padding);
    border: 1px solid var(--glass-panel-border);
    border-radius: var(--modal-link-radius);
    background: var(--glass-panel-bg);
    box-shadow: inset 0 1px 0 var(--glass-panel-highlight);
  }

  :is(body.docs-page, html.subpage body) .docs-inline-links a:hover,
  :is(body.docs-page, html.subpage body) .docs-inline-links a:focus-visible {
    border-color: var(--copper);
    background: var(--glow-muted);
  }

  @media (max-width: 1000px) {
    :is(body.docs-page, html.subpage body) .docs-grid--steps {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    :is(body.docs-page, html.subpage body) .docs-shell > section.docs-hero {
      grid-template-columns: 1fr;
      grid-template-areas:
        'label'
        'title'
        'lead'
        'quote'
        'actions';
      gap: var(--docs-hero-gap-mobile);
      padding: var(--docs-hero-padding-mobile);
    }

    :is(body.docs-page, html.subpage body) .docs-columns,
    :is(body.docs-page, html.subpage body) .faq-layout {
      grid-template-columns: 1fr;
    }

    :is(body.docs-page, html.subpage body) .docs-hero > .manifesto-quote {
      justify-self: start;
      max-width: 18rem;
      text-align: left;
    }

    :is(body.docs-page, html.subpage body) .docs-hero > .manifesto-actions {
      width: 100%;
      justify-self: stretch;
      justify-items: stretch;
      align-self: start;
    }

    :is(body.docs-page, html.subpage body) .docs-hero > .manifesto-actions .btn-solid,
    :is(body.docs-page, html.subpage body) .docs-hero > .manifesto-actions .btn-outline {
      width: 100%;
    }
  }

  @media (max-width: 720px) {
    :is(body.docs-page, html.subpage body) .shell {
      padding: var(--docs-shell-padding-block-mobile);
    }

    :is(body.docs-page, html.subpage body) .docs-shell {
      width: var(--docs-shell-width-mobile);
      gap: var(--docs-shell-gap-mobile);
    }

    :is(body.docs-page, html.subpage body) .docs-hero > .manifesto-title {
      max-width: 9ch;
    }

    :is(body.docs-page, html.subpage body) .docs-hero > .manifesto-quote {
      max-width: none;
      font-size: var(--docs-hero-quote-size-mobile);
    }

    :is(body.docs-page, html.subpage body) .docs-inline-links {
      gap: var(--docs-inline-links-gap-mobile);
    }
  }
</style>
