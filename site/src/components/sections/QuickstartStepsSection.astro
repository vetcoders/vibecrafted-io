---
import { getEntry } from 'astro:content';
import CopyButton from '../../components/CopyButton.svelte';
import { getTranslations, type Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';

const { lang } = Astro.props as { lang: Lang };

const entry = await getEntry('i18n', `${lang}/quickstartsteps`);
if (!entry) {
    throw new Error(`Quickstart steps content not found for lang=${lang}`);
}

interface QuickstartStep {
    kicker: string;
    title: string;
    body: string;
    command?: string;
    commands?: string[];
    note?: string;
}

const steps = (entry.data.steps ?? []) as QuickstartStep[];

// CopyButton labels remain in the i18n dict (UI labels, not redaction-friendly copy).
const copyButton = getTranslations(lang).copyButton;
---
<Reveal client:load tag="section" id="quickstart-steps" class="quickstart-steps-section quickstart-steps-section--operations">
    <div class="docs-grid docs-grid--operations docs-grid--operation-rows">
        {steps.map((step, index) => {
            const commands = step.commands ?? (step.command ? [step.command] : []);
            const note = step.note;

            return (
                <article
                    id={`quickstart-step-${index + 1}`}
                    class="docs-card docs-card--operation docs-card--operation-row docs-card--operational-row"
                >
                    <div class="docs-card__copy">
                        <p class="docs-kicker">{step.kicker}</p>
                        <h3>{step.title}</h3>
                        <p set:html={step.body}></p>
                        {note && <p class="docs-note" set:html={note}></p>}
                    </div>
                    <div class="docs-card__command docs-card__command--stack">
                        {commands.map((command) => (
                            <div class="code-block">
                                <CopyButton
                                    client:visible
                                    class="copy-btn"
                                    textToCopy={command}
                                    defaultLabel={copyButton.default}
                                    copiedLabel={copyButton.copied}
                                    errorLabel={copyButton.error}
                                    defaultAriaLabel={copyButton.defaultAria}
                                    copiedAriaLabel={copyButton.copiedAria}
                                    errorAriaLabel={copyButton.errorAria}
                                />
                                <pre><code>{command}</code></pre>
                            </div>
                        ))}
                    </div>
                </article>
            );
        })}
    </div>
</Reveal>

<style>
  :global(.quickstart-steps-section--operations) {
    width: 100%;
  }
</style>
