---
import SectionShell from '../SectionShell.astro';
import SectionFooter from '../SectionFooter.astro';
import EngineeringCard from '../EngineeringCard.svelte';
import { getTranslations, type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const chrome = getTranslations(lang).landingV2;
const section = getTranslations(lang).sections.evidence;

function mapAccent(accent: string): 'default' | 'rust' | 'teal' {
  if (accent === 'copper') return 'rust';
  if (accent === 'patina') return 'teal';
  return 'default';
}
---

<SectionShell
  number="02"
  title={chrome.engineering.title}
  centerLabel={chrome.engineering.centerLabel}
  figure="02 · DWG VC-002"
  surface="ink"
  seam="to-ink"
  id="engineering"
>
  <div class="eng">
    <h2 class="eng__heading">
      <Fragment set:html={section.titleHtml} />
      <span class="brand-dot">.</span>
    </h2>
    <p class="eng__subtitle">{section.lead}</p>

    <div class="eng__grid">
      {section.items.map((axiom) => (
        <EngineeringCard
          client:visible
          num={axiom.number}
          title={axiom.title}
          body={axiom.body}
          bullets={[...axiom.details]}
          detailsLabel={section.detailsLabel}
          accent={mapAccent(axiom.accent)}
        />
      ))}
    </div>
  </div>

  <SectionFooter nextNumber="03" nextTitle={chrome.shift.title} surface="ink" lang={lang} />
</SectionShell>

<style>
  .eng__heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 4.8vw, 72px);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--fg-on-dark);
    margin: 0 0 24px;
    text-align: center;
  }

  .eng__heading em.accent {
    font-style: italic;
    color: var(--accent);
  }

  .eng__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 17px;
    line-height: 1.55;
    color: var(--fg-on-dark-dim);
    max-width: 64ch;
    margin: 0 auto 72px;
    text-align: center;
  }

  .eng__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .eng__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .eng__heading {
      text-align: left;
    }

    .eng__subtitle {
      text-align: left;
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>
