---
import CopyButton from '../../components/CopyButton.svelte';
import { getTranslations, type Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';

const { lang } = Astro.props as { lang: Lang };
const dict = getTranslations(lang);
const section = dict.sections.get;
const copyButton = dict.copyButton;
---
<section id="get" class="get-section">
    <Reveal tag="div" class="container">
        <div class="section-label">{section.label}</div>
        <h2 class="section-title">{section.title}</h2>
        <p class="section-sub">{section.sub}</p>
        <div class="docs-grid docs-grid--operations docs-grid--install-flow docs-grid--install-rows">
            {section.cards.map((card) => (
                <article class="docs-card docs-card--install docs-card--install-row">
                    <div class="docs-card__step" aria-hidden="true">{card.step}</div>
                    <div class="docs-card__copy">
                        <h3>{card.title}</h3>
                        <p set:html={card.body}></p>
                    </div>
                    <div class="docs-card__command docs-card__command--bar">
                        <div class="install-command-bar">
                            <span class="install-command-bar__prompt">$</span>
                            <code class="install-command-bar__code">{card.command}</code>
                            <CopyButton
                                client:visible
                                class="cb-copy install-command-bar__copy"
                                textToCopy={card.command}
                                defaultLabel={copyButton.upperDefault}
                                copiedLabel={copyButton.copied}
                                errorLabel={copyButton.error}
                                defaultAriaLabel={copyButton.defaultAria}
                                copiedAriaLabel={copyButton.copiedAria}
                                errorAriaLabel={copyButton.errorAria}
                            />
                        </div>
                    </div>
                </article>
            ))}
        </div>
        <div class="get-wizard-cta">
            <a href={section.installWizardHref} class="get-wizard-btn">{section.installWizardLabel}</a>
        </div>
        <div class="docs-inline-links">
            {section.links.map((link) => (
                <a href={link.href} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                    {link.label}
                </a>
            ))}
        </div>
    </Reveal>
</section>
