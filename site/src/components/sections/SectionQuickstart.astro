---
import SectionShell from '../SectionShell.astro';
import SectionFooter from '../SectionFooter.astro';
import QuickstartCarousel from '../QuickstartCarousel.svelte';
import { getTranslations, type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const chrome = getTranslations(lang).landingV2;
const section = getTranslations(lang).v2Sections.quickstart;
---

<SectionShell
  number="06"
  title={chrome.quickstart.title}
  centerLabel={chrome.quickstart.centerLabel}
  figure="06 · DWG VC-006"
  surface="ink"
  seam="to-ink"
  id="quickstart"
>
  <div class="quickstart">
    <h2 class="quickstart__heading">
      <Fragment set:html={section.headingHtml} />
    </h2>

    <QuickstartCarousel client:load lang={lang} />
  </div>

  <SectionFooter nextNumber="07" nextTitle={chrome.references.title} surface="ink" lang={lang} />
</SectionShell>

<style>
  .quickstart__heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 4.8vw, 72px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--fg-on-dark);
    margin: 0 0 56px;
  }

  .quickstart__heading em {
    font-style: italic;
  }

  .quickstart__heading em.accent-2 {
    color: var(--accent-2);
  }
</style>
