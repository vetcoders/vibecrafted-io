---
import { loadCopy } from '../../lib/content';
import SectionShell from '../SectionShell.astro';
import SectionFooter from '../SectionFooter.astro';
import QuickstartCarousel from '../QuickstartCarousel.svelte';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;

const quickstartEntry = { data: await loadCopy('quickstart', lang) };
if (!quickstartEntry) throw new Error(`Missing i18n entry: ${lang}/quickstart-v2`);
type CarouselStep = {
  num: string;
  verb: string;
  accent: string;
  state: number;
  pct: string;
  title: string;
  body: string;
  command: string;
  lands: string[];
};

type CarouselData = {
  ariaLabel: string;
  slideAria: string;
  landsLabel: string;
  convergeLabel: string;
  previousLabel: string;
  nextLabel: string;
  dotsLabel: string;
  goToStep: string;
  steps: CarouselStep[];
};

const section = quickstartEntry.data as {
  title: string;
  centerLabel: string;
  headingHtml: string;
  carousel: CarouselData;
};

const referencesEntry = { data: await loadCopy('references', lang) };
if (!referencesEntry) throw new Error(`Missing i18n entry: ${lang}/references-v2`);
const nextTitle = referencesEntry.data.title as string;
---

<SectionShell
  number="06"
  title={section.title}
  centerLabel={section.centerLabel}
  figure="06 · DWG VC-006"
  surface="ink"
  seam="to-ink"
  id="quickstart"
>
  <div class="quickstart">
    <h2 class="quickstart__heading">
      <Fragment set:html={section.headingHtml} />
      <span class="brand-dot">.</span>
    </h2>

    <QuickstartCarousel client:load copy={section.carousel} />
  </div>

  <SectionFooter nextNumber="07" nextTitle={nextTitle} surface="ink" lang={lang} />
</SectionShell>

<style>
  .quickstart__heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--v2-section-title);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--fg-on-dark);
    margin: 0 0 56px;
  }

  .quickstart__heading em {
    font-style: italic;
  }

  .quickstart__heading em.accent-2 {
    color: var(--accent-2);
  }
</style>
