---
import { getTranslations, type Lang } from '../../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.foundation;
---
<section class="runtime-view">
    <div class="container fade-up">
        <div class="section-label">{section.label}</div>
        <h2 class="section-title">{section.title}</h2>
        <p class="section-sub">{section.sub}</p>
        <div class="foundation-grid">
            {section.cards.map((card) => (
                <a class="foundation-card" href={card.href}>
                    <div class={card.iconClass}>{card.number}</div>
                    <h3>{card.name}</h3>
                    <p class="foundation-role">{card.role}</p>
                    <p>{card.body}</p>
                    <span class="foundation-link">{card.linkLabel}</span>
                </a>
            ))}
        </div>
    </div>
</section>
