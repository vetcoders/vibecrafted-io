---
import { getEntry } from 'astro:content';
import type { Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';
import ProductDetailCard from './ProductDetailCard.astro';

type FoundationLearnPath = {
    label: string;
    lead: string;
    quickstart: string;
    faq: string;
    framework: string;
};

type FoundationCard = {
    number: string;
    href: string;
    name: string;
    iconClass: string;
    role: string;
    body: string;
    linkLabel: string;
};

type FoundationSectionData = {
    label: string;
    title: string;
    sub: string;
    reveal: string;
    learnPath: FoundationLearnPath;
    bullets: Record<string, readonly string[]>;
    cards: FoundationCard[];
};

const { lang } = Astro.props as { lang: Lang };

const entry = await getEntry('i18n', `${lang}/foundation`);
if (!entry) {
    throw new Error(`Foundation content not found for lang=${lang}`);
}
const section = entry.data as FoundationSectionData;
const basePath = `/${lang}`;
const ui = section.learnPath;

const surfacePaths = [
    { href: `${basePath}/quickstart/`, label: ui.quickstart },
    { href: `${basePath}/faq/`, label: ui.faq },
    { href: `${basePath}/framework/`, label: ui.framework },
];

const foundationBullets: Record<string, readonly string[]> = section.bullets;
---
<section class="runtime-view surface--grid" id="foundation">
    <Reveal client:load tag="div" class="container">
        <div class="section-label">{section.label}</div>
        <h2 class="section-title">{section.title}</h2>
        <p class="section-sub">{section.sub}</p>
        <div class="surface-path">
            <p class="surface-path__label">{ui.label}</p>
            <p class="surface-path__lead">{ui.lead}</p>
            <div class="surface-path__links">
                {surfacePaths.map((link) => (
                    <a href={link.href}>{link.label}</a>
                ))}
            </div>
        </div>
        <div class="foundation-grid">
            {section.cards.map((card) => (
                <ProductDetailCard
                    accent={
                        card.name === 'aicx'
                            ? 'copper'
                            : card.name === 'prview'
                              ? 'patina'
                              : card.name === 'ScreenScribe'
                                ? 'muted'
                                : 'steel'
                    }
                    eyebrow={`${card.number} · ${card.role}`}
                    title={card.name}
                    bodyHtml={card.body}
                    revealLabel={section.reveal}
                    bullets={[...(foundationBullets[card.name] ?? [])]}
                />
            ))}
        </div>
    </Reveal>
</section>

<style>
    .runtime-view {
        position: relative;
        isolation: isolate;
        overflow: hidden;
    }

    .runtime-view::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
            radial-gradient(circle at 18% 14%, rgba(178, 135, 85, 0.14), transparent 26%),
            radial-gradient(circle at 86% 4%, rgba(143, 169, 189, 0.12), transparent 24%),
            linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 20%);
        pointer-events: none;
    }

    .surface-path {
        display: grid;
        gap: 0.45rem;
        margin: 0 0 1.1rem;
        padding: 1rem 1.1rem;
        border: 1px solid rgba(218, 197, 167, 0.14);
        border-radius: 1rem;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent),
            rgba(13, 15, 18, 0.58);
        backdrop-filter: blur(12px) saturate(1.05);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .surface-path__label {
        margin: 0;
        color: rgba(225, 176, 116, 0.92);
        font-size: 0.74rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .surface-path__lead {
        margin: 0;
        color: rgba(209, 216, 224, 0.82);
        font-size: 0.95rem;
        line-height: 1.55;
    }

    .surface-path__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        padding-top: 0.45rem;
    }

    .surface-path__links a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.62rem 0.88rem;
        border: 1px solid rgba(218, 197, 167, 0.18);
        border-radius: 999px;
        color: rgba(236, 240, 245, 0.94);
        text-decoration: none;
        background: rgba(255, 255, 255, 0.03);
        transition:
            border-color 160ms ease,
            transform 160ms ease,
            background 160ms ease;
    }

    .surface-path__links a:hover,
    .surface-path__links a:focus-visible {
        border-color: rgba(225, 176, 116, 0.38);
        background: rgba(255, 255, 255, 0.06);
        transform: translateY(-1px);
    }

    .foundation-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .foundation-grid :global(.foundation-icon) {
        margin-bottom: var(--space-sm);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        letter-spacing: 0.05em;
    }

    .foundation-grid :global(.foundation-icon--steel) {
        color: var(--steel);
    }

    .foundation-grid :global(.foundation-icon--copper) {
        color: var(--copper);
    }

    .foundation-grid :global(.foundation-icon--patina) {
        color: var(--patina);
    }

    .foundation-grid :global(.foundation-icon--muted) {
        color: var(--steel-dark);
    }

    @media (max-width: 900px) {
        .foundation-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
