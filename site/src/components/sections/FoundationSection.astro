---
import { getTranslations, type Lang } from '../../lib/i18n';
import ProductDetailCard from './ProductDetailCard.astro';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.foundation;
const basePath = lang === 'pl' ? '/pl' : '/en';
const ui = {
    learnPath: lang === 'pl' ? 'Najpierw ucz się tutaj' : 'Learn here first',
    learnPathLead:
        lang === 'pl'
            ? 'Najpierw zrozum powierzchnię produktu, dopiero potem schodź do źródeł.'
            : 'Understand the product surface first, then move toward source material.',
    quickstart: lang === 'pl' ? 'Szybki start' : 'Quick Start',
    faq: 'FAQ',
    framework: lang === 'pl' ? 'Framework' : 'Framework',
    reveal: lang === 'pl' ? 'Otwórz warstwę' : 'Open layer',
};

const surfacePaths = [
    { href: `${basePath}/quickstart/`, label: ui.quickstart },
    { href: `${basePath}/faq/`, label: ui.faq },
    { href: `${basePath}/framework/`, label: ui.framework },
];

const foundationBullets: Record<string, string[]> = {
    loctree: [
        lang === 'pl'
            ? 'Mapuje repozytorium zanim ktokolwiek zacznie je zmieniać.'
            : 'Maps the repository before anyone starts changing it.',
        lang === 'pl'
            ? 'Chroni przed ślepymi refaktorami i błędnym poczuciem pewności.'
            : 'Protects against blind refactors and false confidence.',
        lang === 'pl'
            ? 'Używaj go, gdy ryzykiem jest struktura.'
            : 'Use it when structure is the risk.',
    ],
    aicx: [
        lang === 'pl'
            ? 'Odzyskuje wcześniejsze decyzje, zamiary i kontekst.'
            : 'Retrieves prior decisions, intent, and context.',
        lang === 'pl'
            ? 'Utrzymuje ciągłość pracy między sesjami.'
            : 'Keeps multi-session work coherent.',
        lang === 'pl'
            ? 'Najbardziej przydatny przy zadaniach rozciągniętych w czasie.'
            : 'Most useful when the work stretches across days.',
    ],
    prview: [
        lang === 'pl'
            ? 'Pakietuje review w trwałe findingi i czytelny gate.'
            : 'Packages review into durable findings and a readable gate.',
        lang === 'pl'
            ? 'Zamyka lukę między terminal dumpem a realnym artefaktem.'
            : 'Closes the gap between terminal dump and a real artifact.',
        lang === 'pl'
            ? 'Używaj przed merge i przed release.'
            : 'Use it before merge and before release.',
    ],
    ScreenScribe: [
        lang === 'pl'
            ? 'Zamienia nagrania ekranu w ustrukturyzowane dowody.'
            : 'Turns screen recordings into structured evidence.',
        lang === 'pl'
            ? 'Patrzy na to, co użytkownik naprawdę zobaczył.'
            : 'Looks at what the user actually saw.',
        lang === 'pl'
            ? 'Najlepszy, gdy trzeba zobaczyć prawdę runtime.'
            : 'Best when runtime truth needs eyes.',
    ],
};
---
<section class="runtime-view" id="foundation">
    <div class="container fade-up">
        <div class="section-label">{section.label}</div>
        <h2 class="section-title">{section.title}</h2>
        <p class="section-sub">{section.sub}</p>
        <div class="surface-path">
            <p class="surface-path__label">{ui.learnPath}</p>
            <p class="surface-path__lead">{ui.learnPathLead}</p>
            <div class="surface-path__links">
                {surfacePaths.map((link) => (
                    <a href={link.href}>{link.label}</a>
                ))}
            </div>
        </div>
        <div class="foundation-grid">
            {section.cards.map((card) => (
                <ProductDetailCard
                    accent={
                        card.name === 'aicx'
                            ? 'copper'
                            : card.name === 'prview'
                              ? 'patina'
                              : card.name === 'ScreenScribe'
                                ? 'muted'
                                : 'steel'
                    }
                    eyebrow={`${card.number} · ${card.role}`}
                    title={card.name}
                    bodyHtml={card.body}
                    revealLabel={ui.reveal}
                    bullets={foundationBullets[card.name] ?? []}
                />
            ))}
        </div>
    </div>
</section>

<style>
    .runtime-view {
        position: relative;
        isolation: isolate;
        overflow: hidden;
    }

    .runtime-view::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
            radial-gradient(circle at 18% 14%, rgba(178, 135, 85, 0.14), transparent 26%),
            radial-gradient(circle at 86% 4%, rgba(143, 169, 189, 0.12), transparent 24%),
            linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 20%);
        pointer-events: none;
    }

    .surface-path {
        display: grid;
        gap: 0.45rem;
        margin: 0 0 1.1rem;
        padding: 1rem 1.1rem;
        border: 1px solid rgba(218, 197, 167, 0.14);
        border-radius: 1rem;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent),
            rgba(13, 15, 18, 0.58);
        backdrop-filter: blur(12px) saturate(1.05);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .surface-path__label {
        margin: 0;
        color: rgba(225, 176, 116, 0.92);
        font-size: 0.74rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .surface-path__lead {
        margin: 0;
        color: rgba(209, 216, 224, 0.82);
        font-size: 0.95rem;
        line-height: 1.55;
    }

    .surface-path__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        padding-top: 0.45rem;
    }

    .surface-path__links a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.62rem 0.88rem;
        border: 1px solid rgba(218, 197, 167, 0.18);
        border-radius: 999px;
        color: rgba(236, 240, 245, 0.94);
        text-decoration: none;
        background: rgba(255, 255, 255, 0.03);
        transition:
            border-color 160ms ease,
            transform 160ms ease,
            background 160ms ease;
    }

    .surface-path__links a:hover,
    .surface-path__links a:focus-visible {
        border-color: rgba(225, 176, 116, 0.38);
        background: rgba(255, 255, 255, 0.06);
        transform: translateY(-1px);
    }

    .foundation-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    @media (max-width: 900px) {
        .foundation-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
