---
interface Props {
    accent?: 'steel' | 'copper' | 'patina' | 'amber' | 'muted';
    eyebrow: string;
    title: string;
    bodyHtml: string;
    revealLabel: string;
    bullets?: string[];
    open?: boolean;
}

const {
    accent = 'steel',
    eyebrow,
    title,
    bodyHtml,
    revealLabel,
    bullets = [],
    open = false,
} = Astro.props as Props;
---
<details class={`product-detail-card product-detail-card--${accent}`} open={open}>
    <summary class="product-detail-card__summary">
        <div class="product-detail-card__eyebrow">{eyebrow}</div>
        <h3 class="product-detail-card__title">{title}</h3>
        <p class="product-detail-card__body"><Fragment set:html={bodyHtml} /></p>
        <span class="product-detail-card__reveal">{revealLabel}</span>
    </summary>

    <div class="product-detail-card__panel">
        {bullets.length > 0 && (
            <ul class="product-detail-card__bullets">
                {bullets.map((bullet) => (
                    <li><Fragment set:html={bullet} /></li>
                ))}
            </ul>
        )}
    </div>
</details>

<style>
    .product-detail-card {
        --card-border: rgba(211, 177, 123, 0.2);
        --card-surface: rgba(13, 15, 18, 0.82);
        --card-glow: rgba(211, 177, 123, 0.16);
        --card-accent: #d3b17b;
        position: relative;
        overflow: clip;
        border: 1px solid var(--card-border);
        border-radius: var(--v2-radius);
        background:
            radial-gradient(circle at 0% 0%, rgba(255, 255, 255, 0.06), transparent 35%),
            linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 24%),
            var(--card-surface);
        box-shadow:
            0 28px 64px rgba(0, 0, 0, 0.34),
            inset 0 1px 0 rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(14px) saturate(1.05);
    }

    .product-detail-card::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.06), transparent 18%),
            radial-gradient(circle at 82% 0%, rgba(255, 255, 255, 0.04), transparent 16%),
            repeating-linear-gradient(
                135deg,
                rgba(255, 255, 255, 0.03) 0,
                rgba(255, 255, 255, 0.03) 1px,
                transparent 1px,
                transparent 12px
            );
        opacity: 0.35;
        mix-blend-mode: soft-light;
    }

    .product-detail-card--steel {
        --card-border: rgba(175, 194, 209, 0.22);
        --card-surface: rgba(12, 15, 19, 0.86);
        --card-glow: rgba(175, 194, 209, 0.14);
        --card-accent: #afc2d1;
    }

    .product-detail-card--copper {
        --card-border: rgba(207, 147, 108, 0.24);
        --card-surface: rgba(16, 13, 12, 0.88);
        --card-glow: rgba(207, 147, 108, 0.16);
        --card-accent: #d49a70;
    }

    .product-detail-card--patina {
        --card-border: rgba(129, 188, 161, 0.24);
        --card-surface: rgba(11, 15, 14, 0.86);
        --card-glow: rgba(129, 188, 161, 0.14);
        --card-accent: #8ec7aa;
    }

    .product-detail-card--amber {
        --card-border: rgba(218, 172, 102, 0.24);
        --card-surface: rgba(17, 14, 10, 0.88);
        --card-glow: rgba(218, 172, 102, 0.15);
        --card-accent: #e1b56f;
    }

    .product-detail-card--muted {
        --card-border: rgba(163, 169, 176, 0.2);
        --card-surface: rgba(12, 14, 17, 0.86);
        --card-glow: rgba(163, 169, 176, 0.12);
        --card-accent: #b3bac1;
    }

    .product-detail-card:hover,
    .product-detail-card[open] {
        box-shadow:
            0 32px 72px rgba(0, 0, 0, 0.42),
            0 0 0 1px var(--card-glow),
            inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .product-detail-card__summary {
        position: relative;
        display: grid;
        gap: 0.75rem;
        padding: 1.15rem 1.1rem 1rem;
        list-style: none;
        cursor: pointer;
        outline: none;
    }

    .product-detail-card__summary::-webkit-details-marker {
        display: none;
    }

    .product-detail-card__summary::after {
        content: '↘';
        position: absolute;
        top: 1rem;
        right: 1rem;
        display: grid;
        place-items: center;
        width: 1.9rem;
        height: 1.9rem;
        border-radius: var(--v2-radius-pill);
        border: 1px solid color-mix(in srgb, var(--card-accent) 55%, transparent);
        color: var(--card-accent);
        background: rgba(255, 255, 255, 0.02);
        transition:
            transform 180ms ease,
            background 180ms ease,
            border-color 180ms ease;
    }

    .product-detail-card:hover .product-detail-card__summary::after,
    .product-detail-card[open] .product-detail-card__summary::after {
        transform: translateY(-1px) rotate(-8deg);
        background: rgba(255, 255, 255, 0.05);
    }

    .product-detail-card__eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        width: fit-content;
        padding: 0.18rem 0.56rem;
        border: 1px solid color-mix(in srgb, var(--card-accent) 32%, transparent);
        border-radius: var(--v2-radius-pill);
        color: color-mix(in srgb, var(--card-accent) 88%, white 12%);
        font-size: 0.72rem;
        letter-spacing: 0.17em;
        text-transform: uppercase;
        background: rgba(255, 255, 255, 0.02);
    }

    .product-detail-card__title {
        margin: 0;
        color: rgba(243, 241, 236, 0.98);
        font-size: clamp(1.1rem, 1.3vw, 1.45rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
    }

    .product-detail-card__body {
        margin: 0;
        max-width: 38rem;
        color: rgba(204, 211, 220, 0.88);
        font-size: 0.95rem;
        line-height: 1.65;
    }

    .product-detail-card__reveal {
        width: fit-content;
        color: color-mix(in srgb, var(--card-accent) 80%, white 20%);
        font-size: 0.74rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .product-detail-card__panel {
        position: relative;
        display: grid;
        gap: 0.8rem;
        padding: 0 1.1rem 1.1rem;
    }

    .product-detail-card__bullets {
        display: grid;
        gap: 0.45rem;
        margin: 0;
        padding: 0;
        list-style: none;
        color: rgba(225, 229, 234, 0.9);
    }

    .product-detail-card__bullets li {
        position: relative;
        padding-left: 1rem;
        line-height: 1.55;
    }

    .product-detail-card__bullets li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.65em;
        width: 0.42rem;
        height: 0.42rem;
        border-radius: var(--v2-radius-pill);
        background: var(--card-accent);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--card-accent) 16%, transparent);
    }

    @media (max-width: 720px) {
        .product-detail-card__summary {
            padding: 1rem 0.95rem 0.9rem;
        }

        .product-detail-card__panel {
            padding: 0 0.95rem 0.95rem;
        }
    }
</style>
