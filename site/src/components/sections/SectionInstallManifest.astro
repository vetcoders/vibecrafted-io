---
/**
 * Install manifest — "What you install" component inventory.
 * Voice contract: the manifesto (concrete, adult, zero mystery meat).
 * One card per installed component: what it is, what it kills, where it lives.
 * Content: site/content/install/{en,pl}.md
 */
import { loadCopy } from '../../lib/content';
import SectionShell from '../SectionShell.astro';
import SectionFooter from '../SectionFooter.astro';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;

const entry = { data: await loadCopy('install', lang) };
if (!entry) throw new Error(`Missing i18n entry: ${lang}/install-manifest-v2`);

const section = entry.data as {
  title: string;
  centerLabel: string;
  headingHtml: string;
  subtitle: string;
  components: Array<{
    name: string;
    kind: string;
    what: string;
    kills: string;
    lives: string;
  }>;
  truthLabel: string;
  truthBody: string;
};

const problemEntry = { data: await loadCopy('about', lang) };
if (!problemEntry) throw new Error(`Missing copy: content/about/${lang}.md`);
const nextTitle = problemEntry.data.title as string;
---

<SectionShell
  number="03"
  title={section.title}
  centerLabel={section.centerLabel}
  figure="03 · DWG VC-003"
  surface="ink"
  seam="to-ink"
  id="install-manifest"
>
  <div class="im">
    <h2 class="im__heading">
      <Fragment set:html={section.headingHtml} />
      <span class="brand-dot">.</span>
    </h2>
    <p class="im__subtitle">{section.subtitle}</p>

    <div class="im__grid">
      {section.components.map((component) => (
        <article class="im__card">
          <header class="im__card-head">
            <h3 class="im__card-name">{component.name}</h3>
            <span class="im__card-kind">{component.kind}</span>
          </header>
          <p class="im__card-what">{component.what}</p>
          <footer class="im__card-lives">
            <code>{component.lives}</code>
          </footer>
        </article>
      ))}
    </div>

    <aside class="im__truth">
      <span class="im__truth-label">{section.truthLabel}</span>
      <p class="im__truth-body">{section.truthBody}</p>
    </aside>
  </div>

  <SectionFooter nextNumber="03" nextTitle={nextTitle} surface="ink" lang={lang} />
</SectionShell>

<style>
  .im {
    min-height: 0;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    gap: 14px;
  }

  .im__heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--v2-section-title);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--fg-on-dark);
    margin: 0;
    text-align: center;
  }

  .im__heading :global(em.accent-2) {
    font-style: italic;
    color: var(--accent-2);
  }

  .im__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.4;
    color: var(--fg-on-dark-dim);
    max-width: 72ch;
    margin: 0 auto;
    text-align: center;
  }

  .im__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 14px;
    margin: 0;
    min-height: 0;
    overflow: hidden;
  }

  @media (max-width: 1024px) {
    .im__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .im__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .im__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    padding: 18px 16px;
    border: 1px solid var(--rule-dark);
    border-radius: var(--v2-radius);
    background: var(--v2-plate);
  }

  .im__card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex: 0 0 auto;
  }

  .im__card-name {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg-on-dark);
    margin: 0;
    white-space: nowrap;
  }

  .im__card-kind {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-on-dark-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .im__card-what {
    font-size: 13px;
    line-height: 1.4;
    color: var(--fg-on-dark);
    margin: 0;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
  }

  .im__card-kills {
    font-size: 12px;
    line-height: 1.35;
    font-style: italic;
    color: var(--accent);
    margin: 0;
    flex: 0 0 auto;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .im__card-lives {
    margin-top: auto;
    flex: 0 0 auto;
    padding-top: 6px;
    border-top: 1px dashed var(--line-on-dark, rgba(255, 255, 255, 0.14));
  }

  .im__card-lives code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-on-dark-dim);
  }

  .im__truth {
    max-width: 76ch;
    margin: 0 auto;
    padding: 12px 16px;
    border-left: 2px solid var(--accent-2);
    background: rgba(255, 255, 255, 0.02);
  }

  .im__truth-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin-bottom: 8px;
  }

  .im__truth-body {
    font-size: 14px;
    line-height: 1.65;
    color: var(--fg-on-dark);
    margin: 0;
  }
</style>
