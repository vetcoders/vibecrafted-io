---
import SectionShell from '../SectionShell.astro';
import SectionFooter from '../SectionFooter.astro';
import { getTranslations, type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const chrome = getTranslations(lang).landingV2;
const section = getTranslations(lang).v2Sections.problem;
---

<SectionShell
  number="01"
  title={chrome.problem.title}
  centerLabel={chrome.problem.centerLabel}
  figure="01"
  surface="paper"
  seam="to-paper"
  id="about"
>
  <div class="problem">
    <div class="problem__col problem__col--heading">
      <h2 class="problem__heading">
        <Fragment set:html={section.headingHtml} />
        <span class="brand-dot">.</span>
      </h2>
      <p class="problem__body">{section.body}</p>
    </div>

    {section.symptoms.map((symptom) => (
      <div class="problem__col">
        <span class="problem__symptom-label">{symptom.label}</span>
        <p class="problem__symptom-body">{symptom.body}</p>
      </div>
    ))}
  </div>

  <SectionFooter nextNumber="02" nextTitle={chrome.engineering.title} surface="paper" lang={lang} />
</SectionShell>

<style>
  .problem {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .problem__heading {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.2vw, 62px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--fg-on-paper);
    margin: 0 0 24px;
  }

  .problem__heading em.accent {
    font-style: italic;
    color: var(--accent);
  }

  .problem__heading em.accent-2 {
    font-style: italic;
    color: var(--accent-2);
  }

  .problem__body {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg-on-paper-dim);
    max-width: 34ch;
    margin: 0;
  }

  .problem__symptom-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-on-paper-mute);
    margin-bottom: 14px;
  }

  .problem__symptom-body {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-on-paper-dim);
    margin: 0;
  }

  @media (max-width: 900px) {
    .problem {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
