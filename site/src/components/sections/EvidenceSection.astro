---
import Reveal from '../Reveal.svelte';
import EvidenceDeck from './EvidenceDeck.svelte';
import { getTranslations, type Lang } from '../../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.evidence;
---
<section class="science-view view" id="evidence">
    <div class="container">
        <Reveal client:load tag="div" class="science-prose">
            <h2><Fragment set:html={section.titleHtml} /></h2>
            <p>{section.lead}</p>
        </Reveal>
        <EvidenceDeck client:load lang={lang} />
    </div>
</section>

<style>
    .science-view {
        background: linear-gradient(180deg, var(--overlay-subtle), var(--overlay-md));
    }

    .science-view .container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: var(--view-inner);
    }

    .science-prose {
        max-width: 800px;
        margin-bottom: var(--space-xl);
        text-align: center;
    }

    .science-prose h2 {
        margin-bottom: var(--space-md);
        color: var(--stone-light);
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        font-weight: 700;
        line-height: 1.1;
    }

    .science-prose p {
        color: color-mix(in srgb, var(--steel-dark) 76%, rgba(240, 243, 247, 0.44));
        font-size: 1.05rem;
        line-height: 1.7;
    }
</style>
