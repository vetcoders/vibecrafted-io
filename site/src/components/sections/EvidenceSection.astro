---
import Reveal from '../Reveal.svelte';
import { getTranslations, type Lang } from '../../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.evidence;
---
<section class="science-view view" id="evidence">
    <div class="container">
        <Reveal client:load tag="div" class="science-prose">
            <h2><Fragment set:html={section.titleHtml} /></h2>
            <p>{section.lead}</p>
        </Reveal>
        <Reveal client:load tag="div" class="evidence-grid" delay={80}>
            {section.items.map((item) => (
                <div class="evidence-item">
                    <span class="evidence-num">{item.number}</span>
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                </div>
            ))}
        </Reveal>
    </div>
</section>
