---
import Reveal from '../Reveal.svelte';
import EvidenceDeck from './EvidenceDeck.svelte';
import { getTranslations, type Lang } from '../../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.evidence;
---
<section class="science-view view surface--grid" id="evidence">
    <div class="container">
        <Reveal client:load tag="div" class="science-prose">
            <h2><Fragment set:html={section.titleHtml} /></h2>
            <p>{section.lead}</p>
        </Reveal>
        <EvidenceDeck client:load lang={lang} />
    </div>
</section>

<style>
    .science-view {
        background: linear-gradient(180deg, var(--overlay-subtle), var(--overlay-md));
    }

    .science-view .container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: var(--view-inner);
    }

    .science-prose {
        max-width: 800px;
        margin-bottom: var(--space-xl);
        text-align: center;
    }

    .science-prose h2 {
        margin-bottom: var(--space-md);
        color: var(--ink);
        font-family: var(--font-head);
        font-weight: 350;
        font-size: clamp(2rem, 4vw, 3rem);
        letter-spacing: -0.02em;
        line-height: 1.05;
    }

    .science-prose h2 em {
        font-style: italic;
        font-weight: 300;
        color: var(--orange);
    }

    .science-prose p {
        color: var(--ink-dim);
        font-family: var(--font-head);
        font-style: italic;
        font-weight: 350;
        font-size: 1.1rem;
        line-height: 1.5;
    }
</style>
