---
import { getEntry } from 'astro:content';
import Reveal from '../Reveal.svelte';
import EvidenceDeck from './EvidenceDeck.svelte';
import type { Lang } from '../../lib/i18n';

type EvidenceItem = {
    number: string;
    accent?: 'steel' | 'copper' | 'patina';
    title: string;
    body: string;
    details: string[];
};

type EvidenceSectionData = {
    titleHtml: string;
    lead: string;
    revealLabel: string;
    closeLabel: string;
    detailsLabel: string;
    items: EvidenceItem[];
};

const { lang } = Astro.props as { lang: Lang };

const entry = await getEntry('i18n', `${lang}/evidence`);
if (!entry) {
    throw new Error(`Evidence content not found for lang=${lang}`);
}
const section = entry.data as EvidenceSectionData;

const deckData = {
    items: section.items,
    detailsLabel: section.detailsLabel,
    revealLabel: section.revealLabel,
    closeLabel: section.closeLabel,
};
---
<section class="science-view view surface--grid" id="evidence">
    <div class="container">
        <Reveal client:load tag="div" class="science-prose">
            <h2><Fragment set:html={section.titleHtml} /></h2>
            <p>{section.lead}</p>
        </Reveal>
        <EvidenceDeck client:load data={deckData} />
    </div>
</section>

<style>
    .science-view {
        background: linear-gradient(180deg, var(--overlay-subtle), var(--overlay-md));
    }

    .science-view .container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: var(--view-inner);
    }

    .science-prose {
        max-width: 800px;
        margin-bottom: var(--space-xl);
        text-align: center;
    }

    .science-prose h2 {
        margin-bottom: var(--space-md);
        color: var(--ink);
        font-family: var(--font-head);
        font-weight: 350;
        font-size: clamp(2rem, 4vw, 3rem);
        letter-spacing: -0.02em;
        line-height: 1.05;
    }

    .science-prose h2 em {
        font-style: italic;
        font-weight: 300;
        color: var(--orange);
    }

    .science-prose p {
        color: var(--ink-dim);
        font-family: var(--font-head);
        font-style: italic;
        font-weight: 350;
        font-size: 1.1rem;
        line-height: 1.5;
    }
</style>
