---
import DiffusionCanvas from '../../components/DiffusionCanvas.svelte';
import { getTranslations, type Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.marbles;
---
<section class="diffusion-section surface--grid" id="marbles">
    <Reveal client:load tag="div" class="container">
        <div class="section-label">{section.label}</div>
        <h2 class="section-title">{section.title}</h2>
        <p class="section-sub">{section.sub}</p>
        <div class="diffusion-visual">
            <div class="diffusion-canvas-wrap">
                <DiffusionCanvas client:only="svelte" lang={lang} />
            </div>
            <div class="diffusion-text">
                <h3>{section.heading}</h3>
                <div class="formula-stack">
                    {section.formulas.map((formula) => (
                        <div class="formula-track">
                            <span>{formula.label}</span>
                            <code>{formula.code}</code>
                        </div>
                    ))}
                </div>
                <div class="diffusion-steps" aria-label={section.stepsAria}>
                    {section.steps.map((step) => <span>{step}</span>)}
                </div>
                <p class="diffusion-note">{section.note}</p>
            </div>
        </div>
        <div class="framework-portal-card">
            <div class="framework-portal-card__copy">
                <p class="framework-playground-shell__kicker">{section.portal.kicker}</p>
                <h3>{section.portal.title}</h3>
                <p>{section.portal.body}</p>
            </div>
            <div class="framework-portal-card__actions">
                <a class="framework-playground-shell__link" href={section.frameworkHref}>{section.portal.cta}</a>
                <p>{section.portal.note}</p>
            </div>
        </div>
    </Reveal>
</section>

<style>
    .diffusion-section {
        align-items: flex-start;
        min-height: auto;
        padding: clamp(2.25rem, 4vw, 3rem) 0;
        background:
            radial-gradient(circle at 18% 18%, rgba(184, 115, 51, 0.08), transparent 24%),
            radial-gradient(circle at 84% 20%, rgba(90, 138, 122, 0.06), transparent 22%),
            var(--diffusion-section-surface);
    }

    .diffusion-visual {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(1.6rem, 2.6vw, 2.4rem);
        align-items: center;
        margin-bottom: 1.8rem;
    }

    .diffusion-canvas-wrap {
        position: relative;
        aspect-ratio: 1;
        max-width: clamp(300px, 30vw, 360px);
        margin: 0 auto;
    }

    .diffusion-canvas-wrap :global(canvas) {
        width: 100%;
        height: 100%;
        display: block;
        border-radius: 50%;
        border: 2px solid var(--card-border);
        filter: drop-shadow(0 24px 44px rgba(0, 0, 0, 0.26));
    }

    .diffusion-text {
        display: grid;
        gap: 0.85rem;
    }

    .diffusion-text h3 {
        margin-bottom: 0;
        font-size: clamp(1.25rem, 2vw, 1.45rem);
    }

    .diffusion-text p {
        margin-bottom: 0;
        color: var(--text-secondary);
    }

    .formula-stack {
        display: grid;
        gap: 0.6rem;
    }

    .formula-track {
        display: grid;
        gap: 0.35rem;
        padding: 0.82rem 0.92rem;
        border: 1px solid var(--glass-panel-border);
        border-radius: 8px;
        background: var(--glass-panel-bg);
        backdrop-filter: blur(16px) saturate(116%);
        -webkit-backdrop-filter: blur(16px) saturate(116%);
        box-shadow: inset 0 1px 0 var(--glass-panel-highlight);
    }

    .formula-track span {
        color: var(--copper-bright);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .formula-track code {
        color: var(--stone-light);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        line-height: 1.8;
    }

    .diffusion-steps {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    .diffusion-steps span {
        display: inline-flex;
        align-items: center;
        min-height: 2rem;
        padding: 0.38rem 0.7rem;
        border: 1px solid rgba(163, 184, 199, 0.14);
        border-radius: 999px;
        background: rgba(9, 10, 12, 0.42);
        color: rgba(196, 212, 224, 0.78);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.08em;
    }

    .diffusion-note {
        max-width: 38rem;
    }

    .framework-portal-card {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(260px, 0.92fr);
        gap: 1.1rem;
        align-items: start;
        padding: 1.15rem;
        margin: 0 0 1.75rem;
        border: 1px solid var(--glass-panel-border);
        border-radius: var(--radius-lg);
        background: var(--framework-portal-surface);
        backdrop-filter: blur(24px) saturate(122%);
        -webkit-backdrop-filter: blur(24px) saturate(122%);
        box-shadow: var(--elevated-panel-shadow);
    }

    .framework-portal-card__copy {
        display: grid;
        gap: 0.65rem;
    }

    .framework-portal-card__copy h3 {
        font-size: clamp(1.25rem, 2.4vw, 1.85rem);
        line-height: 1.06;
    }

    .framework-portal-card__copy p:last-child,
    .framework-portal-card__actions p {
        color: var(--steel-dark);
    }

    .framework-portal-card__actions {
        display: grid;
        gap: 0.75rem;
        justify-items: start;
    }

    .framework-playground-shell__kicker {
        margin-bottom: 0.65rem;
        color: var(--copper-bright);
        font-family: var(--font-mono);
        font-size: 0.74rem;
        letter-spacing: 0.16em;
        line-height: 1.1;
        text-transform: uppercase;
    }

    .framework-playground-shell__link {
        justify-self: start;
        padding-bottom: 0.2rem;
        border-bottom: 1px solid var(--glow);
        color: var(--copper);
        font-family: var(--font-head);
        font-size: 0.82rem;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
    }

    .framework-playground-shell__link:hover,
    .framework-playground-shell__link:focus-visible {
        color: var(--copper-bright);
        border-bottom-color: var(--framework-link-hover-border);
    }

    @media (max-width: 768px) {
        .diffusion-section {
            padding: 2.1rem 0 2.35rem;
        }

        .diffusion-visual {
            grid-template-columns: 1fr;
            gap: 1.25rem;
            margin-bottom: 1.45rem;
        }

        .diffusion-canvas-wrap {
            max-width: min(18rem, 74vw);
        }

        .framework-portal-card {
            grid-template-columns: 1fr;
            gap: 0.95rem;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }
    }
</style>
