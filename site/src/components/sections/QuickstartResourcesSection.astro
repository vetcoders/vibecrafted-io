---
import { getTranslations, type Lang } from '../../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.quickstartResources;
---
<section class="fade-up">
    <div class="docs-columns">
        {section.cards.map((card) => (
            <article class="resource-card">
                <p class="resource-kicker">{card.kicker}</p>
                <h3>{card.title}</h3>
                <ul class="resource-list">
                    {card.items.map((item) => (
                        <li><Fragment set:html={item} /></li>
                    ))}
                </ul>
            </article>
        ))}
    </div>
    <div class="docs-inline-links">
        {section.links.map((link) => (
            <a href={link.href} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                {link.label}
            </a>
        ))}
    </div>
</section>
