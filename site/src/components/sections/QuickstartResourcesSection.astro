---
import { getTranslations, type Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';
import ProductDetailCard from './ProductDetailCard.astro';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.quickstartResources;
const basePath = `/${lang}`;
const nextStep = section.nextStep;

const pathLinks = [
    { href: `${basePath}/faq/`, label: nextStep.faq },
    { href: `${basePath}/#foundation`, label: nextStep.foundation },
    { href: `${basePath}/`, label: nextStep.overview },
];
---
<Reveal client:load tag="section" id="quickstart-resources">
    <div class="docs-columns">
        {section.cards.map((card, index) => (
            <div id={`quickstart-resource-${index + 1}`}>
                <ProductDetailCard
                    accent={index === 0 ? 'amber' : 'steel'}
                    eyebrow={card.kicker}
                    title={card.title}
                    bodyHtml={card.items[0]}
                    revealLabel={section.reveal}
                    bullets={card.items.slice(1)}
                />
            </div>
        ))}
    </div>
    <div class="surface-path">
        <p class="surface-path__label">{nextStep.label}</p>
        <p class="surface-path__lead">{nextStep.lead}</p>
        <div class="surface-path__links">
            {pathLinks.map((link) => (
                <a href={link.href}>{link.label}</a>
            ))}
        </div>
    </div>
    <details class="source-layer">
        <summary>{section.sourceLabel}</summary>
        <div class="source-layer__content">
            {section.links.map((link) => (
                <a
                    href={link.href}
                    rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    target={link.href.startsWith('http') ? '_blank' : undefined}
                >
                    {link.label}
                </a>
            ))}
        </div>
    </details>
</Reveal>

<style>
    .docs-columns {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .surface-path {
        display: grid;
        gap: 0.45rem;
        margin-top: 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid rgba(218, 197, 167, 0.14);
        border-radius: 1rem;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent),
            rgba(13, 15, 18, 0.58);
        backdrop-filter: blur(12px) saturate(1.05);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .surface-path__label {
        margin: 0;
        color: rgba(225, 176, 116, 0.92);
        font-size: 0.74rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .surface-path__lead {
        margin: 0;
        color: rgba(209, 216, 224, 0.82);
        font-size: 0.95rem;
        line-height: 1.55;
    }

    .surface-path__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        padding-top: 0.45rem;
    }

    .surface-path__links a,
    .source-layer__content a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.62rem 0.88rem;
        border: 1px solid rgba(218, 197, 167, 0.18);
        border-radius: 999px;
        color: rgba(236, 240, 245, 0.94);
        text-decoration: none;
        background: rgba(255, 255, 255, 0.03);
        transition:
            border-color 160ms ease,
            transform 160ms ease,
            background 160ms ease;
    }

    .surface-path__links a:hover,
    .surface-path__links a:focus-visible,
    .source-layer__content a:hover,
    .source-layer__content a:focus-visible {
        border-color: rgba(225, 176, 116, 0.38);
        background: rgba(255, 255, 255, 0.06);
        transform: translateY(-1px);
    }

    .source-layer {
        margin-top: 1rem;
        padding: 0.95rem 1rem 0.2rem;
        border: 1px solid rgba(175, 182, 190, 0.14);
        border-radius: 1rem;
        background: rgba(9, 11, 14, 0.48);
    }

    .source-layer summary {
        cursor: pointer;
        list-style: none;
        color: rgba(232, 235, 239, 0.88);
        font-size: 0.8rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

    .source-layer summary::-webkit-details-marker {
        display: none;
    }

    .source-layer__content {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        padding: 0.9rem 0 0.8rem;
    }

    @media (max-width: 900px) {
        .docs-columns {
            grid-template-columns: 1fr;
        }
    }
</style>
