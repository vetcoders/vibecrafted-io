---
import { getEntry } from 'astro:content';
import MermaidViewer from '../../components/MermaidViewer.svelte';
import {
    mermaidEn,
    mermaidFullEn,
    mermaidFullPl,
    mermaidPl,
} from '../../lib/diagrams/pipeline';
import type { Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';

type PipelineNote = { title: string; body: string };
type PipelineMermaidModal = { open: string; close: string; title: string };
type PipelineData = {
    label: string;
    title: string;
    sub: string;
    mermaidModal: PipelineMermaidModal;
    notes: PipelineNote[];
};

const { lang } = Astro.props as { lang: Lang };

const entry = await getEntry('i18n', `${lang}/pipeline`);
if (!entry) {
    throw new Error(`Pipeline content not found for lang=${lang}`);
}
const section = entry.data as PipelineData;

const mermaidCode = lang === 'pl' ? mermaidPl : mermaidEn;
const mermaidFull = lang === 'pl' ? mermaidFullPl : mermaidFullEn;
---
<section class="pipeline-section surface--grid" id="pipeline">
    <Reveal client:load tag="div" class="container">
        <div class="section-label">{section.label}</div>
        <h2 class="section-title">{section.title}</h2>
        <p class="section-sub">{section.sub}</p>
        <MermaidViewer
            client:visible
            highlightedCode=""
            code={mermaidCode}
            fullCode={mermaidFull}
            modalLabels={section.mermaidModal}
        />
        <div class="pipeline-notes">
            {section.notes.map((note, index) => (
                <article class="pipeline-note">
                    <span class="pipeline-num">{String(index + 1).padStart(2, '0')}</span>
                    <h3>{note.title}</h3>
                    <p>{note.body}</p>
                </article>
            ))}
        </div>
    </Reveal>
</section>

<style>
    .pipeline-section {
        background: var(--glass-panel-bg-strong);
        border: 1px solid var(--glass-panel-border);
        border-radius: 10px;
        padding: var(--space-md);
        margin-bottom: var(--space-md);
        backdrop-filter: blur(24px) saturate(122%);
        -webkit-backdrop-filter: blur(24px) saturate(122%);
        box-shadow: 0 18px 40px var(--shadow-soft), inset 0 1px 0 var(--glass-panel-highlight);
    }

    .pipeline-notes {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .pipeline-note {
        border: 1px solid var(--glass-panel-border);
        border-radius: 8px;
        background: var(--glass-panel-bg);
        backdrop-filter: blur(20px) saturate(120%);
        -webkit-backdrop-filter: blur(20px) saturate(120%);
        box-shadow: 0 12px 30px var(--shadow-sm), inset 0 1px 0 var(--glass-panel-highlight);
        padding: 1rem 1rem 0.9rem;
    }

    .pipeline-num {
        display: block;
        margin-bottom: var(--space-xs);
        color: var(--orange);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        opacity: 0.9;
    }

    .pipeline-note h3 {
        margin-bottom: 0.35rem;
        font-size: 0.96rem;
    }

    .pipeline-note p {
        margin: 0;
        color: var(--steel-edge-strong);
        font-size: 0.9rem;
    }

    @media (max-width: 768px) {
        .pipeline-notes {
            grid-template-columns: 1fr;
        }
    }
</style>
