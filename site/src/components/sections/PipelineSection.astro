---
import MermaidViewer from '../../components/MermaidViewer.svelte';
import { getTranslations, type Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.pipeline;
---
<section class="pipeline-section" id="pipeline">
    <Reveal client:load tag="div" class="container">
        <div class="section-label">{section.label}</div>
        <h2 class="section-title">{section.title}</h2>
        <p class="section-sub">{section.sub}</p>
        <MermaidViewer client:visible highlightedCode={section.highlighted} code={section.mermaid} />
        <div class="pipeline-notes">
            {section.notes.map((note, index) => (
                <article class="pipeline-note">
                    <span class="pipeline-num">{String(index + 1).padStart(2, '0')}</span>
                    <h3>{note.title}</h3>
                    <p>{note.body}</p>
                </article>
            ))}
        </div>
    </Reveal>
</section>

<style>
    .pipeline-section {
        background: var(--glass-panel-bg-strong);
        border: 1px solid var(--glass-panel-border);
        border-radius: 10px;
        padding: var(--space-md);
        margin-bottom: var(--space-md);
        backdrop-filter: blur(24px) saturate(122%);
        -webkit-backdrop-filter: blur(24px) saturate(122%);
        box-shadow: 0 18px 40px var(--shadow-soft), inset 0 1px 0 var(--glass-panel-highlight);
    }

    .pipeline-notes {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .pipeline-note {
        border: 1px solid var(--glass-panel-border);
        border-radius: 8px;
        background: var(--glass-panel-bg);
        backdrop-filter: blur(20px) saturate(120%);
        -webkit-backdrop-filter: blur(20px) saturate(120%);
        box-shadow: 0 12px 30px var(--shadow-sm), inset 0 1px 0 var(--glass-panel-highlight);
        padding: 1rem 1rem 0.9rem;
    }

    .pipeline-num {
        display: block;
        margin-bottom: var(--space-xs);
        color: var(--copper);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        letter-spacing: 0.05em;
        opacity: 0.8;
    }

    .pipeline-note h3 {
        margin-bottom: 0.35rem;
        font-size: 0.96rem;
    }

    .pipeline-note p {
        margin: 0;
        color: var(--steel-edge-strong);
        font-size: 0.9rem;
    }

    @media (max-width: 768px) {
        .pipeline-notes {
            grid-template-columns: 1fr;
        }
    }
</style>
