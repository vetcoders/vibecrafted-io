---
import PipelineHero from '../../components/PipelineHero.svelte';
import { getTranslations, type Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.pipeline;
---
<section class="pipeline-section surface--grid" id="pipeline">
    <Reveal client:load tag="div" class="container">
        <div class="section-label">{section.label}</div>
        <h2 class="section-title">{section.title}</h2>
        <p class="section-sub">{section.sub}</p>
        <PipelineHero
            client:visible
            stages={section.hero.stages}
            source={section.mermaidFull}
            modalLabels={section.mermaidModal}
            controls={section.controls}
        />
        <div class="pipeline-notes">
            {section.notes.map((note, index) => (
                <article class="pipeline-note">
                    <span class="pipeline-num">{String(index + 1).padStart(2, '0')}</span>
                    <h3>{note.title}</h3>
                    <p>{note.body}</p>
                </article>
            ))}
        </div>
    </Reveal>
</section>

<style>
    .pipeline-section {
        background: var(--glass-panel-bg-strong);
        border: 1px solid var(--glass-panel-border);
        border-radius: 10px;
        padding: clamp(1.4rem, 2.6vw, 2.2rem);
        margin-bottom: var(--space-md);
        backdrop-filter: blur(24px) saturate(122%);
        -webkit-backdrop-filter: blur(24px) saturate(122%);
        box-shadow: 0 18px 40px var(--shadow-soft), inset 0 1px 0 var(--glass-panel-highlight);
    }

    .pipeline-notes {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.9rem;
        margin-top: 1.4rem;
    }

    .pipeline-note {
        border: 1px solid var(--glass-panel-border);
        border-radius: 8px;
        background: var(--glass-panel-bg);
        backdrop-filter: blur(20px) saturate(120%);
        -webkit-backdrop-filter: blur(20px) saturate(120%);
        box-shadow: 0 12px 30px var(--shadow-sm), inset 0 1px 0 var(--glass-panel-highlight);
        padding: 0.85rem 0.95rem 0.8rem;
    }

    .pipeline-num {
        display: block;
        margin-bottom: var(--space-xs);
        color: var(--steel-dark);
        font-family: var(--font-mono);
        font-size: 0.65rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        opacity: 0.85;
    }

    .pipeline-note h3 {
        margin-bottom: 0.3rem;
        font-size: 0.86rem;
        color: var(--steel-edge, var(--stone-light));
    }

    .pipeline-note p {
        margin: 0;
        color: var(--steel-edge-muted, var(--steel-edge-strong));
        font-size: 0.82rem;
        line-height: 1.5;
    }

    @media (max-width: 768px) {
        .pipeline-notes {
            grid-template-columns: 1fr;
        }
    }
</style>
