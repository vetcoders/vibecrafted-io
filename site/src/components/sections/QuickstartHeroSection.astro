---
import { getEntry } from 'astro:content';
import type { Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';

const { lang } = Astro.props as { lang: Lang };

interface QuickstartHeroData {
    label: string;
    title: string;
    lead: string;
    quote: string;
    primaryHref: string;
    primaryLabel: string;
    secondaryHref: string;
    secondaryLabel: string;
}

const entry = await getEntry('i18n', `${lang}/quickstarthero`);
if (!entry) {
    throw new Error(`Quickstart hero content not found for lang=${lang}`);
}
const section = entry.data as unknown as QuickstartHeroData;
---
<Reveal client:load tag="section" class="docs-hero quickstart-hero-section quickstart-hero-section--operations">
    <div class="section-label">{section.label}</div>
    <h1 class="manifesto-title">{section.title}<span class="brand-dot">.</span></h1>
    <p class="manifesto-lead">{section.lead}</p>
    <p class="manifesto-quote">{section.quote}</p>
    <div class="manifesto-actions">
        <a class="btn-solid" href={section.primaryHref}>{section.primaryLabel}</a>
        <a class="btn-outline" href={section.secondaryHref}>{section.secondaryLabel}</a>
    </div>
</Reveal>

<style>
  :global(.quickstart-hero-section),
  :global(.quickstart-hero-section--operations) {
    width: 100%;
    max-width: none;
  }

  :global(.quickstart-hero-section) .manifesto-title {
    max-width: 12ch;
  }
</style>
