---
import { getTranslations, type Lang } from '../../lib/i18n';
import DocsSearch from '../DocsSearch.svelte';
import Reveal from '../Reveal.svelte';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.quickstartHero;
---
<Reveal client:load tag="section" class="docs-hero quickstart-hero-section quickstart-hero-section--operations">
    <div class="section-label">{section.label}</div>
    <h1 class="manifesto-title">{section.title}</h1>
    <p class="manifesto-lead">{section.lead}</p>
    <p class="manifesto-quote">{section.quote}</p>
    <div class="manifesto-actions">
        <a class="btn-solid" href={section.primaryHref}>{section.primaryLabel}</a>
        <a class="btn-outline" href={section.secondaryHref}>{section.secondaryLabel}</a>
    </div>
    <DocsSearch client:load lang={lang} section="quickstart" />
</Reveal>
