---
import MarbleCanvas from '../../components/MarbleCanvas.svelte';
import { getTranslations, type Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';

const { lang } = Astro.props as { lang: Lang };
const hero = getTranslations(lang).sections.hero;
---
<article class="founder-manifesto surface--grid">
    <Reveal client:load tag="section" class="hero-split hero-section">
        <header class="hero-copy">
            <h1 class="manifesto-title">
                <span class="manifesto-title__script">𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍.</span>
                <span class="manifesto-title__rule" aria-hidden="true"></span>
                <span class="manifesto-title__framework">
                    <Fragment set:html={hero.frameworkTitleHtml} />
                </span>
            </h1>
            <p class="manifesto-lead">{hero.lead}</p>
            <p class="manifesto-quote">
                <Fragment set:html={hero.quoteHtml} />
            </p>
            <div class="manifesto-actions">
                <a href="#evidence" class="btn-solid">{hero.evidence}</a>
                <a href={hero.quickstartHref} class="btn-outline">{hero.quickstart}</a>
            </div>
        </header>
        <MarbleCanvas client:only="svelte" lang={lang} />
    </Reveal>
</article>

<style>
    .founder-manifesto {
        width: var(--page-shell);
        margin: 0 auto;
        padding: 0;
        font-family: var(--font-body);
    }

    .hero-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-lg);
        align-items: stretch;
        min-height: var(--view-inner);
        padding: calc(var(--view-offset) + var(--space-lg)) 0 var(--space-lg);
        scroll-snap-align: start;
    }

    .hero-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-self: stretch;
        padding-top: clamp(1.5rem, 5vh, 3rem);
        padding-bottom: clamp(1rem, 4vh, 2.5rem);
    }

    .manifesto-title {
        gap: clamp(0.55rem, 1.2vh, 1rem);
    }

    @media (max-width: 900px) {
        .hero-split {
            grid-template-columns: 1fr;
            gap: var(--space-md);
            min-height: var(--view-inner);
            padding-top: calc(var(--view-offset) + var(--space-md));
        }

        .hero-copy {
            text-align: center;
            align-self: auto;
            padding-top: 0;
        }

        .manifesto-title__rule,
        .manifesto-lead {
            margin-inline: auto;
        }

        .manifesto-actions {
            justify-content: center;
        }
    }

    @media (max-width: 560px) {
        .hero-split {
            gap: 1.1rem;
            padding-top: calc(var(--view-offset) + 0.85rem);
        }

        .hero-copy {
            align-items: stretch;
            padding-inline: 0.1rem;
        }

        .manifesto-actions {
            width: min(100%, 19rem);
            margin-inline: auto;
            flex-direction: column;
            align-items: stretch;
        }

        .manifesto-actions .btn-solid,
        .manifesto-actions .btn-outline {
            width: 100%;
            padding-inline: 1.25rem;
        }
    }
</style>
