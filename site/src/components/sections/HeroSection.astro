---
import MarbleCanvas from '../../components/MarbleCanvas.svelte';
import { getTranslations, type Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';

const { lang } = Astro.props as { lang: Lang };
const hero = getTranslations(lang).sections.hero;
---
<article class="founder-manifesto">
    <Reveal client:load tag="section" class="hero-split">
        <header class="hero-copy">
            <h1 class="manifesto-title">
                <span class="manifesto-title__script">𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍.</span>
                <span class="manifesto-title__rule" aria-hidden="true"></span>
                <span class="manifesto-title__framework">
                    <Fragment set:html={hero.frameworkTitleHtml} />
                </span>
            </h1>
            <p class="manifesto-lead">{hero.lead}</p>
            <p class="manifesto-quote">
                <Fragment set:html={hero.quoteHtml} />
            </p>
            <div class="manifesto-actions">
                <a href="#evidence" class="btn-solid">{hero.evidence}</a>
                <a href={hero.quickstartHref} class="btn-outline">{hero.quickstart}</a>
            </div>
        </header>
        <MarbleCanvas client:only="svelte" lang={lang} />
    </Reveal>
</article>
