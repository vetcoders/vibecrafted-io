---
import { getEntry } from 'astro:content';
import type { Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';

const { lang } = Astro.props as { lang: Lang };

const entry = await getEntry('i18n', `${lang}/faqcontent`);
if (!entry) {
    throw new Error(`FAQ content not found for lang=${lang}`);
}

interface FaqItem {
    open?: boolean;
    questionHtml: string;
    answerHtml: string;
}

interface FaqGroup {
    title: string;
    items: FaqItem[];
}

interface FaqLink {
    href: string;
    label: string;
}

interface LearningPathBlock {
    label: string;
    lead: string;
    quickstart: string;
    foundation: string;
    overview: string;
}

const data = entry.data;
const groups = (data.groups ?? []) as FaqGroup[];
const links = (data.links ?? []) as FaqLink[];
const learningPathCopy = data.learningPath as LearningPathBlock;
const sourceLabel = data.sourceLabel as string;

const basePath = `/${lang}`;
const learningPath = [
    { href: `${basePath}/quickstart/`, label: learningPathCopy.quickstart },
    { href: `${basePath}/#foundation`, label: learningPathCopy.foundation },
    { href: `${basePath}/`, label: learningPathCopy.overview },
];
---
<Reveal client:load tag="section" id="faq-content">
    <div class="surface-path">
        <p class="surface-path__label">{learningPathCopy.label}</p>
        <p class="surface-path__lead">{learningPathCopy.lead}</p>
        <div class="surface-path__links">
            {learningPath.map((link) => (
                <a href={link.href}>{link.label}</a>
            ))}
        </div>
    </div>

    <div class="faq-layout">
        {groups.map((group, groupIndex) => (
            <article class="faq-group">
                <h2>{group.title}</h2>
                {group.items.map((item, itemIndex) => {
                    const isOpen = item.open === true;

                    return (
                        <details class="faq-item" id={`faq-${groupIndex + 1}-${itemIndex + 1}`} open={isOpen}>
                            <summary><Fragment set:html={item.questionHtml} /></summary>
                            <p set:html={item.answerHtml}></p>
                        </details>
                    );
                })}
            </article>
        ))}
    </div>

    <details class="source-layer">
        <summary>{sourceLabel}</summary>
        <div class="source-layer__content">
            {links.map((link) => (
                <a
                    href={link.href}
                    rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    target={link.href.startsWith('http') ? '_blank' : undefined}
                >
                    {link.label}
                </a>
            ))}
        </div>
    </details>
</Reveal>

<style>
    .surface-path {
        display: grid;
        gap: 0.45rem;
        margin-bottom: 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid rgba(218, 197, 167, 0.14);
        border-radius: var(--v2-radius);
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent),
            rgba(13, 15, 18, 0.58);
        backdrop-filter: blur(12px) saturate(1.05);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .surface-path__label {
        margin: 0;
        color: rgba(225, 176, 116, 0.92);
        font-size: 0.74rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .surface-path__lead {
        margin: 0;
        color: rgba(209, 216, 224, 0.82);
        font-size: 0.95rem;
        line-height: 1.55;
    }

    .surface-path__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        padding-top: 0.45rem;
    }

    .surface-path__links a,
    .source-layer__content a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.62rem 0.88rem;
        border: 1px solid rgba(218, 197, 167, 0.18);
        border-radius: var(--v2-radius-pill);
        color: rgba(236, 240, 245, 0.94);
        text-decoration: none;
        background: rgba(255, 255, 255, 0.03);
        transition:
            border-color 160ms ease,
            transform 160ms ease,
            background 160ms ease;
    }

    .surface-path__links a:hover,
    .surface-path__links a:focus-visible,
    .source-layer__content a:hover,
    .source-layer__content a:focus-visible {
        border-color: rgba(225, 176, 116, 0.38);
        background: rgba(255, 255, 255, 0.06);
        transform: translateY(-1px);
    }

    .faq-layout {
        display: grid;
        gap: 1rem;
    }

    .faq-group {
        position: relative;
        overflow: clip;
        padding: 1.1rem 1.1rem 1rem;
        border: 1px solid rgba(218, 197, 167, 0.14);
        border-radius: var(--v2-radius);
        background:
            radial-gradient(circle at 0% 0%, rgba(255, 255, 255, 0.05), transparent 40%),
            linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 18%),
            rgba(13, 15, 18, 0.62);
        box-shadow:
            0 24px 60px rgba(0, 0, 0, 0.28),
            inset 0 1px 0 rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(12px) saturate(1.05);
    }

    .faq-group h2 {
        margin: 0 0 0.8rem;
        color: rgba(243, 241, 236, 0.96);
        font-size: 1rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .faq-item {
        border-top: 1px solid rgba(218, 197, 167, 0.12);
        padding-top: 0.8rem;
    }

    .faq-item + .faq-item {
        margin-top: 0.8rem;
    }

    .faq-item:first-of-type {
        border-top: 0;
        padding-top: 0;
    }

    .faq-item summary {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.5rem;
        cursor: pointer;
        color: rgba(236, 240, 245, 0.96);
        font-family: var(--font-head);
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.35;
        list-style: none;
    }

    .faq-item summary::-webkit-details-marker {
        display: none;
    }

    .faq-item summary::after {
        content: '+';
        flex-shrink: 0;
        min-width: 1ch;
        color: rgba(225, 176, 116, 0.94);
        font-family: var(--font-mono);
        font-size: 1rem;
        line-height: 1;
    }

    .faq-item[open] summary {
        color: rgba(225, 176, 116, 0.96);
    }

    .faq-item[open] summary::after {
        content: '−';
    }

    .faq-item p,
    .faq-item ul {
        margin-top: 0.7rem;
        color: rgba(209, 216, 224, 0.82);
        line-height: 1.65;
    }

    .faq-item ul {
        padding-left: 1.1rem;
    }

    .source-layer {
        margin-top: 1rem;
        padding: 0.95rem 1rem 0.2rem;
        border: 1px solid rgba(175, 182, 190, 0.14);
        border-radius: var(--v2-radius);
        background: rgba(9, 11, 14, 0.48);
    }

    .source-layer summary {
        cursor: pointer;
        list-style: none;
        color: rgba(232, 235, 239, 0.88);
        font-size: 0.8rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

    .source-layer summary::-webkit-details-marker {
        display: none;
    }

    .source-layer__content {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        padding: 0.9rem 0 0.8rem;
    }

    @media (min-width: 900px) {
        .faq-layout {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>
