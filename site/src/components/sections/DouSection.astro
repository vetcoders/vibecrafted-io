---
import { getTranslations, type Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.dou;
const trajectoryScale = [0, 25, 50, 75, 100];
const trajectoryBars = [
  { className: 'bar-fill bar-fill--copper', label: section.bars[0], score: 15 },
  { className: 'bar-fill bar-fill--copper', label: section.bars[1], score: 40 },
  { className: 'bar-fill bar-fill--steel', label: section.bars[2], score: 65 },
  { className: 'bar-fill bar-fill--steel', label: section.bars[3], score: 85 },
  { className: 'bar-fill bar-fill--patina', label: section.bars[4], score: 100 },
];
---
<section class="manifesto-section" id="dou">
    <Reveal client:load tag="div" class="container">
        <div class="section-label">{section.label}</div>
        <h2 class="section-title">{section.title}</h2>
        <div class="manifesto-layout">
            <div class="manifesto-block">
                <blockquote>{section.quote}</blockquote>
                <p class="manifesto-lead">{section.lead}</p>
                <p class="manifesto-diagnostic-label">{section.diagnosticLabel}</p>
                <ul class="plague-list">
                    {section.checklist.map((item) => (
                        <li>
                            <span class={item.kind === 'check' ? 'check' : 'cross'}>
                                {item.kind === 'check' ? '+' : '–'}
                            </span>
                            {item.text}
                        </li>
                    ))}
                </ul>
                <p class="manifesto-summary">{section.summary}</p>
            </div>
            <div class="transition-visual transition-visual--dou">
                <p class="transition-caption">{section.caption}</p>
                <div class="trajectory-panel">
                    <div class="trajectory-scale" aria-hidden="true">
                        {trajectoryScale.map((tick) => (
                            <span>{tick}</span>
                        ))}
                    </div>
                    <div class="trajectory" id="trajectoryBars" role="list" aria-label={section.scoreline}>
                        {trajectoryBars.map((bar) => (
                            <div class="bar-step" role="listitem" style={`--bar-value: ${bar.score};`}>
                                <div class="bar-copy">
                                    <span class="bar-label">{bar.label}</span>
                                    <span class="bar-score">{bar.score}</span>
                                </div>
                                <div class="bar-track" aria-hidden="true">
                                    <span class={bar.className}></span>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
                <p class="transition-scoreline">{section.scoreline}</p>
            </div>
        </div>
    </Reveal>
</section>

<style>
    .manifesto-section {
        background: var(--manifesto-section-surface);
    }

    .manifesto-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
        gap: 1.5rem;
        align-items: stretch;
    }

    .manifesto-block,
    .transition-visual {
        padding: clamp(1.35rem, 2vw, 1.9rem);
        border: 1px solid var(--glass-panel-border);
        border-radius: var(--radius-lg);
        background: var(--glass-panel-bg-strong);
        backdrop-filter: blur(24px) saturate(122%);
        -webkit-backdrop-filter: blur(24px) saturate(122%);
        box-shadow: var(--elevated-panel-shadow);
    }

    .manifesto-block {
        max-width: min(54rem, 100%);
    }

    .transition-visual {
        text-align: center;
    }

    .transition-visual--dou {
        height: 100%;
        min-height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: stretch;
        gap: 1.1rem;
        text-align: left;
    }

    .manifesto-block blockquote {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
        border-left: 3px solid var(--copper);
        color: var(--steel-dark);
        font-size: 1.05rem;
        font-style: italic;
    }

    .manifesto-block .plague-list {
        list-style: none;
        margin: 1.5rem 0;
    }

    .manifesto-block .plague-list li {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.4rem 0;
        font-size: 0.95rem;
    }

    .manifesto-block .plague-list .check {
        color: var(--patina);
    }

    .manifesto-block .plague-list .cross {
        color: var(--copper);
    }

    .manifesto-diagnostic-label {
        margin-bottom: 0.8rem;
        font-family: var(--font-head);
        font-weight: 600;
    }

    .manifesto-summary {
        margin-top: 1.5rem;
    }

    .transition-caption {
        color: var(--steel-dark);
        font-family: var(--font-head);
        font-size: 0.85rem;
    }

    .transition-scoreline {
        color: var(--steel-dark);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .trajectory-panel {
        display: grid;
        gap: 0.95rem;
        padding: clamp(1rem, 1.7vw, 1.2rem);
        border: 1px solid var(--glass-panel-border);
        border-radius: calc(var(--radius-md) + 2px);
        background:
            radial-gradient(circle at top right, rgba(184, 115, 51, 0.12), transparent 38%),
            linear-gradient(180deg, rgba(18, 20, 24, 0.9), rgba(10, 11, 14, 0.76));
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .trajectory-scale {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.5rem;
        color: var(--steel-dark);
        font-family: var(--font-mono);
        font-size: clamp(0.58rem, 1.4vw, 0.68rem);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .trajectory-scale span {
        text-align: center;
    }

    .trajectory-scale span:first-child {
        text-align: left;
    }

    .trajectory-scale span:last-child {
        text-align: right;
    }

    .trajectory {
        display: grid;
        gap: 0.85rem;
    }

    .bar-step {
        display: grid;
        gap: 0.55rem;
    }

    .bar-copy {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .bar-label {
        color: var(--stone-light);
        font-family: var(--font-head);
        font-size: 0.88rem;
        font-weight: 600;
    }

    .bar-score {
        color: var(--copper-bright);
        font-family: var(--font-mono);
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.08em;
    }

    .bar-track {
        position: relative;
        height: 1rem;
        overflow: hidden;
        border: 1px solid var(--glass-panel-border);
        border-radius: 999px;
        background: linear-gradient(180deg, rgba(229, 236, 245, 0.08), rgba(255, 255, 255, 0.02));
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }

    .bar-track::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
            linear-gradient(90deg, transparent 24.6%, rgba(255, 255, 255, 0.08) 24.6%, rgba(255, 255, 255, 0.08) 25.4%, transparent 25.4%),
            linear-gradient(90deg, transparent 49.6%, rgba(255, 255, 255, 0.08) 49.6%, rgba(255, 255, 255, 0.08) 50.4%, transparent 50.4%),
            linear-gradient(90deg, transparent 74.6%, rgba(255, 255, 255, 0.08) 74.6%, rgba(255, 255, 255, 0.08) 75.4%, transparent 75.4%);
        pointer-events: none;
    }

    .bar-fill {
        display: block;
        height: 100%;
        width: calc(var(--bar-value) * 1%);
        min-width: 0.75rem;
        border-radius: inherit;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
        transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .bar-fill--copper {
        background: linear-gradient(90deg, rgba(184, 115, 51, 0.88), rgba(212, 144, 92, 0.98));
    }

    .bar-fill--steel {
        background: linear-gradient(90deg, rgba(129, 149, 163, 0.92), rgba(196, 212, 224, 0.98));
    }

    .bar-fill--patina {
        background: linear-gradient(90deg, rgba(90, 138, 122, 0.9), rgba(127, 181, 163, 0.98));
    }

    @media (max-width: 980px) {
        .manifesto-layout {
            grid-template-columns: 1fr;
        }

        .transition-visual--dou {
            gap: 1rem;
        }
    }

    @media (max-width: 560px) {
        .trajectory-panel {
            padding: 0.9rem;
            gap: 0.8rem;
        }

        .trajectory {
            gap: 0.75rem;
        }

        .bar-copy {
            gap: 0.65rem;
        }

        .bar-label {
            font-size: 0.82rem;
        }

        .bar-score,
        .transition-scoreline {
            font-size: 0.68rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .bar-fill {
            transition: none;
        }
    }
</style>
