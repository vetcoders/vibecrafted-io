---
import { getTranslations, type Lang } from '../../lib/i18n';
import Reveal from '../Reveal.svelte';

const { lang } = Astro.props as { lang: Lang };
const section = getTranslations(lang).sections.dou;
const trajectoryBars = [
  { className: 'bar bar--copper', height: '24', label: section.bars[0], score: '15' },
  { className: 'bar bar--copper', height: '40', label: section.bars[1], score: '40' },
  { className: 'bar bar--steel', height: '65', label: section.bars[2], score: '65' },
  { className: 'bar bar--steel', height: '85', label: section.bars[3], score: '85' },
  { className: 'bar bar--patina', height: '100', label: section.bars[4], score: '100' },
];
---
<section class="manifesto-section" id="dou">
    <Reveal client:load tag="div" class="container">
        <div class="section-label">{section.label}</div>
        <h2 class="section-title">{section.title}</h2>
        <div class="manifesto-layout">
            <div class="manifesto-block">
                <blockquote>{section.quote}</blockquote>
                <p class="manifesto-lead">{section.lead}</p>
                <p class="manifesto-diagnostic-label">{section.diagnosticLabel}</p>
                <ul class="plague-list">
                    {section.checklist.map((item) => (
                        <li>
                            <span class={item.kind === 'check' ? 'check' : 'cross'}>
                                {item.kind === 'check' ? '+' : '–'}
                            </span>
                            {item.text}
                        </li>
                    ))}
                </ul>
                <p class="manifesto-summary">{section.summary}</p>
            </div>
            <div class="transition-visual transition-visual--dou">
                <p class="transition-caption">{section.caption}</p>
                <div class="trajectory" id="trajectoryBars">
                    {trajectoryBars.map((bar) => (
                        <div class={bar.className} data-h={bar.height}>
                            <span class="bar-label">{bar.label}</span>
                            <span class="bar-score">{bar.score}</span>
                        </div>
                    ))}
                </div>
                <p class="transition-scoreline">{section.scoreline}</p>
            </div>
        </div>
    </Reveal>
</section>
