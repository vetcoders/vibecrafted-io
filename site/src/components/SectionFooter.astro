---
interface Props {
  nextNumber: string;
  nextTitle: string;
  surface?: 'ink' | 'paper';
  class?: string;
}

const { nextNumber, nextTitle, surface = 'ink', class: className } = Astro.props;
---

<div class:list={['v2-section__footer', `v2-section__footer--${surface}`, className]}>
  <div class="v2-section__footer-rule" aria-hidden="true"></div>
  <div class="v2-section__footer-row">
    <span class="v2-section__footer-label">CONTINUES § {nextNumber} · {nextTitle}</span>
    <span class="v2-section__footer-arrow" aria-hidden="true">↓</span>
  </div>
</div>

<style>
  .v2-section__footer {
    margin-top: 28px;
  }

  .v2-section__footer-rule {
    height: 1px;
    background: var(--rule-dark);
    margin-bottom: 18px;
  }

  .v2-section__footer--paper .v2-section__footer-rule {
    background: var(--rule-paper);
  }

  .v2-section__footer-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-on-dark-mute);
  }

  .v2-section__footer--paper .v2-section__footer-row {
    color: var(--fg-on-paper-mute);
  }

  .v2-section__footer-arrow {
    justify-self: end;
    font-size: 12px;
  }
</style>
