---
import { Image } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import CopyButton from '../components/CopyButton.svelte';
import SearchShell from '../components/SearchShell.svelte';
import SiteNav from '../components/SiteNav.svelte';
import logo32 from '../assets/presence/logo-32.png';
import { getTranslations, type Lang } from '../lib/i18n';
import { getDocsSearchData } from '../lib/search/docs';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = 'Release engine for AI-built software. Ship AI-built software without the vibe hangover.',
  lang = 'en',
  ogImage = '/presence/og-image.png',
  ogType = 'website',
} = Astro.props as Props;

const dict = getTranslations(lang);
const navLabels = dict.nav;
const footer = dict.footer;
const copyButton = dict.copyButton;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://vibecrafted.io';

function normalizeCanonicalPath(pathname: string) {
  const normalized = pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '/');
  if (normalized === '/') return '/en/';
  if (normalized === '/presence/quickstart/') return '/en/quickstart/';
  if (normalized === '/presence/framework/') return '/en/framework/';
  if (normalized === '/presence/faq/') return '/en/faq/';
  return normalized;
}

const canonicalPath = normalizeCanonicalPath(Astro.url.pathname);
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
const is404 = Astro.url.pathname.includes('404');
const robotsContent = is404 ? 'noindex,follow' : 'index,follow';

const i18nMap: Record<string, string> = {
  '/': '/pl/',
  '/en/': '/pl/',
  '/en/quickstart/': '/pl/quickstart/',
  '/en/faq/': '/pl/faq/',
  '/en/framework/': '/pl/framework/',
  '/en/install/': '/pl/install/',
};

const i18nMapReverse: Record<string, string> = Object.fromEntries(
  Object.entries(i18nMap).map(([enPath, plPath]) => [plPath, enPath]),
);

function getAlternates(path: string): { en: string; pl: string } | null {
  const normalized = path.endsWith('/') ? path : `${path}/`;
  if (normalized in i18nMap) return { en: normalized, pl: i18nMap[normalized] };
  if (normalized in i18nMapReverse) return { en: i18nMapReverse[normalized], pl: normalized };
  return null;
}

const alternates = getAlternates(canonicalPath);
const ogLocale = lang === 'pl' ? 'pl_PL' : 'en_US';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalUrl,
  inLanguage: lang,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Vibecrafted',
    url: siteUrl,
    publisher: {
      '@type': 'Organization',
      name: 'VetCoders',
      url: 'https://github.com/VetCoders',
    },
  },
});

const isPl = lang === 'pl';
const normalizedPath = canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`;
const toggleHref = alternates ? (isPl ? alternates.en : alternates.pl) : (isPl ? '/' : '/pl/');
const toggleHreflang = isPl ? 'en' : 'pl';
const navPaths = {
  home: isPl ? '/pl/' : '/en/',
  framework: isPl ? '/pl/framework/' : '/en/framework/',
  quickstart: isPl ? '/pl/quickstart/' : '/en/quickstart/',
  faq: isPl ? '/pl/faq/' : '/en/faq/',
  install: isPl ? '/pl/install/' : '/en/install/',
};

const isHomePage = normalizedPath === navPaths.home;
const isDocsPage = normalizedPath === navPaths.quickstart || normalizedPath === navPaths.faq;
const isFrameworkPage = normalizedPath === navPaths.framework;
const showInstallBanner = isHomePage;
const searchDefaultSection = normalizedPath === navPaths.faq ? 'faq' : 'all';

// Preload all three search bundles server-side so the SearchShell client
// component never imports astro:content (server-only). The bundles are
// passed as props.
const [searchDataAll, searchDataQuickstart, searchDataFaq] = await Promise.all([
  getDocsSearchData(lang, 'all'),
  getDocsSearchData(lang, 'quickstart'),
  getDocsSearchData(lang, 'faq'),
]);

const sectionLinks = {
  pipeline: isHomePage ? '#pipeline' : `${navPaths.home}#pipeline`,
  skills: isHomePage ? '#skills' : `${navPaths.home}#skills`,
  marbles: isHomePage ? '#marbles' : `${navPaths.home}#marbles`,
  dou: isHomePage ? '#dou' : `${navPaths.home}#dou`,
  get: '#get',
};

const aboutHref = isHomePage ? '#skills' : `${navPaths.home}#skills`;
const runtimeHref = isHomePage ? '#pipeline' : `${navPaths.home}#pipeline`;
const vcHref = 'https://github.com/VetCoders';

const footerLinks = [
  { href: navPaths.quickstart, label: navLabels.quickstart },
  { href: navPaths.faq, label: navLabels.faq },
  { href: 'https://github.com/VetCoders/vibecrafted', label: navLabels.github, external: true },
  {
    href: 'https://github.com/VetCoders/vibecrafted/blob/main/LICENSE',
    label: navLabels.license,
    external: true,
  },
  {
    href: 'https://github.com/VetCoders/vibecrafted/blob/main/SECURITY.md',
    label: navLabels.security,
    external: true,
  },
];

const primaryLinks = [
  { href: aboutHref, label: navLabels.about },
  { href: runtimeHref, label: navLabels.runtime },
  { href: sectionLinks.marbles, label: navLabels.marbles },
  { href: sectionLinks.dou, label: navLabels.dou },
  { href: navPaths.framework, label: navLabels.board, current: normalizedPath === navPaths.framework },
];

---

<!DOCTYPE html>
<html lang={lang} class:list={[isDocsPage && 'subpage', isFrameworkPage && 'framework-subpage']}>
<head>
    <ClientRouter />
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>{title}</title>
    <meta content={description} name="description">
    <meta content={title} property="og:title">
    <meta content={description} property="og:description">
    <meta content={ogImageUrl} property="og:image">
    <meta content="1536" property="og:image:width">
    <meta content="1024" property="og:image:height">
    <meta content="image/png" property="og:image:type">
    <meta content={description ?? title} property="og:image:alt">
    <meta content={ogType} property="og:type">
    <meta content={canonicalUrl} property="og:url">
    <meta content="Vibecrafted" property="og:site_name">
    <meta content={ogLocale} property="og:locale">
    {alternates && <meta content={lang === 'pl' ? 'en_US' : 'pl_PL'} property="og:locale:alternate" />}
    <meta content="summary_large_image" name="twitter:card">
    <meta content={title} name="twitter:title">
    <meta content={description} name="twitter:description">
    <meta content={ogImageUrl} name="twitter:image">
    <meta content={description ?? title} name="twitter:image:alt">
    <meta content="@VetCoders" name="twitter:site">
    <meta content="T5B-vRPBGSbPiROhDSZPMplZ6bA5yCgT_3egIGQ8kIE" name="google-site-verification">
    <meta content={robotsContent} name="robots">
    <meta content="#0d1117" name="theme-color">
    <meta
        http-equiv="Content-Security-Policy"
        content={[
          "default-src 'none'",
          "script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://plausible.io",
          "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
          "style-src-attr 'unsafe-inline'",
          "img-src 'self' data:",
          "font-src 'self' https://fonts.gstatic.com",
          "connect-src 'self' https://plausible.io",
          "frame-src 'none'",
          "worker-src 'self'",
          "manifest-src 'self'",
          "base-uri 'self'",
          "form-action 'self'",
        ].join('; ')}
    >
    <link href={canonicalUrl} rel="canonical">
    {alternates && <>
      <link href={new URL(alternates.en, siteUrl).href} hreflang="en" rel="alternate" />
      <link href={new URL(alternates.pl, siteUrl).href} hreflang="pl" rel="alternate" />
      <link href={new URL(alternates.en, siteUrl).href} hreflang="x-default" rel="alternate" />
    </>}
    <link href="/presence/favicon.ico" rel="icon" sizes="32x32">
    <link href="/presence/logo-64.png" rel="icon" sizes="64x64" type="image/png">
    <link href="/presence/logo-128.png" rel="apple-touch-icon">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Allura&family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=JetBrains+Mono:ital,wght@0,400..800;1,400..800&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <script is:inline crossorigin="anonymous" integrity="sha384-7Q8XaCgFJlm82NdMNnX7AIyZbdTjUre2eR4TpKK1Pko3zKXorgTIGVpnnLho+UAe" src="https://cdn.jsdelivr.net/npm/mermaid@10.8.0/dist/mermaid.min.js"></script>
    <script is:inline defer data-domain="vibecrafted.io" src="https://plausible.io/js/script.js"></script>
</head>
<body class:list={[isDocsPage && 'docs-page', isFrameworkPage && 'framework-page']}>
    <a class="skip-link" href="#main-content">{navLabels.skip}</a>

    <div class="topbar">
        <header class="nav-shell vt-site-topbar">
            <a class="brand" href={navPaths.home}>
                <span class="brand-mark vt-site-brand" transition:persist>
                    <Image
                        src={logo32}
                        alt=""
                        aria-hidden="true"
                        class="brand-logo"
                        width={24}
                        height={24}
                        densities={[1, 2]}
                        format="webp"
                    />
                    <span class="brand-wordmark">𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍.</span>
                </span>
            </a>
            <SiteNav
                client:load
                links={primaryLinks}
                installHref={navPaths.install}
                installLabel={navLabels.install}
                vcHref={vcHref}
                vcLabel={navLabels.vc}
                vcTitle={navLabels.vcLabel}
                toggleHref={toggleHref}
                toggleLabel={navLabels.toggleShort}
                toggleHreflang={toggleHreflang}
                toggleLang={toggleHreflang}
                githubLabel={navLabels.github}
                menuLabel={navLabels.menu}
                closeLabel={navLabels.closeMenu}
                primaryNavLabel={navLabels.navPrimary}
            />
        </header>
    </div>

    {showInstallBanner && (
        <div class="curl-banner vt-site-install-banner" id="install-command-banner" transition:persist>
            <code><span class="cb-g">$</span> curl -fsSL https://vibecrafted.io/install.sh | bash -s -- --gui</code>
            <CopyButton
                client:visible
                class="cb-copy"
                textToCopy="curl -fsSL https://vibecrafted.io/install.sh | bash -s -- --gui"
                defaultLabel={copyButton.default}
                copiedLabel={copyButton.copied}
                errorLabel={copyButton.error}
                defaultAriaLabel={copyButton.defaultAria}
                copiedAriaLabel={copyButton.copiedAria}
                errorAriaLabel={copyButton.errorAria}
            />
        </div>
    )}

    <main class:list={['shell', isDocsPage && 'shell--docs', isFrameworkPage && 'shell--framework']} id="main-content">
        <slot />
    </main>

    <footer class="footer-shell vt-site-footer" aria-label={footer.ariaLabel}>
        <div class="footer-container">
            <div class="footer-brand vt-site-footer-brand" transition:persist>
                <Image
                    src={logo32}
                    alt=""
                    aria-hidden="true"
                    class="footer-logo"
                    width={24}
                    height={24}
                    densities={[1, 2]}
                    format="webp"
                />
                <span class="footer-title">{footer.brand}</span>
            </div>
            <p class="footer-tagline">{footer.tagline}</p>
            <nav class="footer-links" aria-label={navLabels.navFooter}>
                {footerLinks.map((link) => (
                    <a href={link.href} rel={link.external ? 'noopener noreferrer' : undefined}>
                        {link.label}
                    </a>
                ))}
            </nav>
            <p class="footer-copyright">{footer.copyright}</p>
        </div>
    </footer>

    <SearchShell
        client:load
        transition:persist="search-shell"
        lang={lang}
        defaultSection={searchDefaultSection}
        searchDataAll={searchDataAll}
        searchDataQuickstart={searchDataQuickstart}
        searchDataFaq={searchDataFaq}
    />
</body>
</html>

<style is:global>
  .vt-site-topbar {
    view-transition-name: site-topbar;
  }

  .vt-site-brand {
    view-transition-name: site-brand;
  }

  .vt-site-install-banner {
    view-transition-name: site-install-banner;
  }

  .vt-site-footer {
    view-transition-name: site-footer;
  }

  .vt-site-footer-brand {
    view-transition-name: site-footer-brand;
  }

  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-old(root) {
      animation-duration: 0.22s;
      animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
    }

    ::view-transition-new(root) {
      animation-duration: 0.34s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    ::view-transition-group(site-topbar),
    ::view-transition-group(site-footer) {
      animation-duration: 0.3s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    ::view-transition-group(site-install-banner) {
      animation-duration: 0.42s;
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }

    ::view-transition-group(site-brand),
    ::view-transition-group(site-footer-brand) {
      animation-duration: 0.5s;
      animation-timing-function: cubic-bezier(0.18, 1, 0.3, 1);
    }

    ::view-transition-old(site-topbar),
    ::view-transition-new(site-topbar),
    ::view-transition-old(site-brand),
    ::view-transition-new(site-brand),
    ::view-transition-old(site-footer-brand),
    ::view-transition-new(site-footer-brand) {
      animation-timing-function: cubic-bezier(0.18, 1, 0.3, 1);
    }

    ::view-transition-old(site-topbar),
    ::view-transition-new(site-topbar) {
      animation-duration: 0.3s;
    }

    ::view-transition-old(site-footer),
    ::view-transition-new(site-footer),
    ::view-transition-old(site-install-banner),
    ::view-transition-new(site-install-banner) {
      animation-duration: 0.38s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--nav-height);
    background: var(--surface-glass);
    backdrop-filter: var(--blur);
    border-bottom: 1px solid var(--card-border);
  }

  .nav-shell {
    width: var(--page-shell);
    max-width: var(--page-shell);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 100%;
    padding: 0;
    min-width: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--steel-edge);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: inherit;
    padding: 0;
    background: none;
    border-radius: 0;
    box-shadow: none;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .brand:hover .brand-mark,
  .brand:focus-visible .brand-mark {
    transform: translateY(-1px);
  }

  .brand-wordmark {
    color: var(--steel-edge);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
  }

  .brand-logo {
    margin-left: 0;
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--steel-border-soft);
  }

  .curl-banner {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 6px 5vw;
    border-bottom: 1px solid var(--card-border);
    background: var(--surface-banner);
    backdrop-filter: var(--blur);
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.12s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.12s ease;
  }

  .topbar:has(.nav-get-zone:hover, .nav-get-zone:focus-within) + .curl-banner,
  .curl-banner:hover,
  .curl-banner:focus-within {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .curl-banner code {
    color: var(--text-secondary);
    font-family: 'SF Mono', 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.76rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
    text-align: center;
    white-space: normal;
  }

  .curl-banner .cb-g {
    color: var(--copper);
    margin-right: 8px;
  }

  .curl-banner .cb-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    flex-shrink: 0;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--copper-border);
    border-radius: 4px;
    background: none;
    color: var(--copper);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.18s ease;
  }

  .curl-banner .cb-copy:hover,
  .curl-banner .cb-copy:focus-visible {
    background: var(--copper);
    color: var(--stone-deep);
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(184, 115, 51, 0.18);
  }

  .footer-shell {
    width: min(var(--page-shell), calc(100% - 1.25rem));
    margin: clamp(2rem, 6vh, 3rem) auto 1.25rem;
    padding: var(--footer-shell-padding);
    border: 1px solid var(--glass-panel-border);
    border-radius: var(--radius-lg);
    background: var(--glass-panel-bg-strong);
    backdrop-filter: var(--footer-shell-backdrop);
    -webkit-backdrop-filter: var(--footer-shell-backdrop);
    box-shadow: var(--footer-shell-shadow);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--footer-shell-gap);
    position: relative;
    overflow: visible;
    isolation: isolate;
    scroll-snap-align: start;
    scroll-margin-top: var(--view-offset);
    text-align: center;
    z-index: 1;
  }

  body.framework-page .footer-shell {
    scroll-snap-align: none;
  }

  .footer-container {
    width: min(100%, 56rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.72rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    color: var(--steel-edge);
    font-family: var(--font-mono);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .footer-logo {
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--steel-border-soft);
  }

  .footer-title {
    color: var(--steel-edge);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .footer-tagline {
    margin: 0;
    max-width: 34rem;
    color: var(--steel-dark);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1.35;
    text-align: center;
    text-transform: none;
  }

  .footer-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--footer-links-gap);
    margin: 0;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: auto;
    padding: 0.15rem 0;
    color: var(--steel-dark);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 0.2s ease,
      transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
      text-shadow 0.18s ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--steel);
    transform: translateY(-1px);
    text-shadow: 0 0 14px rgba(163, 184, 199, 0.1);
  }

  .footer-copyright {
    margin: 0;
    color: var(--steel-dark);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .curl-banner {
      padding: 6px 4vw;
      gap: 10px;
    }

    .curl-banner code {
      font-size: 0.65rem;
    }
  }

  @media (max-width: 720px) {
    html.subpage {
      --nav-height: 64px;
    }

    :root {
      --nav-height: 76px;
      --banner-height: 48px;
      --chrome-offset: calc(var(--nav-height) + var(--banner-height));
      --page-shell: min(100% - 1rem, 42rem);
    }

    .topbar {
      height: auto;
      min-height: var(--nav-height);
    }

    .nav-shell {
      width: min(100% - 1rem, 42rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.65rem 0.75rem;
      height: auto;
      padding: 0.55rem 0 0.7rem;
      overflow: visible;
    }

    .brand {
      min-height: 3rem;
      min-width: 0;
      flex-shrink: 0;
    }

    .subpage .topbar {
      height: auto;
      min-height: var(--nav-height);
    }

    .subpage .nav-shell {
      padding: 0.55rem 0 0.7rem;
    }

    .subpage .brand {
      gap: 0.45rem;
    }

    .subpage .brand-wordmark {
      font-size: 0.84rem;
      letter-spacing: 0;
    }

    .footer-tagline {
      width: auto;
