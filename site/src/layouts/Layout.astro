---
import { Image } from 'astro:assets';
import CopyButton from '../components/CopyButton.svelte';
import ScrollObserver from '../components/ScrollObserver.svelte';
import CardStrip from '../components/CardStrip.svelte';
import logo32 from '../assets/presence/logo-32.png';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'pl';
  ogImage?: string;
  ogType?: string;
}

const { title, description = "A convergence-driven system for shipping software with AI agents.", lang = "en", ogImage = "/presence/og-image.png", ogType = "website" } = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? "https://vibecrafted.io";

function normalizeCanonicalPath(pathname: string) {
  const normalized = pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '/');
  if (normalized === '/') return '/en/';
  if (normalized === '/presence/quickstart/') return '/en/quickstart/';
  if (normalized === '/presence/framework/') return '/en/framework/';
  if (normalized === '/presence/faq/') return '/en/faq/';
  return normalized;
}

const canonicalPath = normalizeCanonicalPath(Astro.url.pathname);
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
const is404 = Astro.url.pathname.includes('404');
const robotsContent = is404 ? 'noindex,follow' : 'index,follow';

/* i18n alternate map: en path -> pl path */
const i18nMap: Record<string, string> = {
  '/': '/pl/',
  '/en/': '/pl/',
  '/en/quickstart/': '/pl/quickstart/',
  '/en/faq/': '/pl/faq/',
  '/en/framework/': '/pl/framework/',
};
/* Build reverse map */
const i18nMapReverse: Record<string, string> = Object.fromEntries(
  Object.entries(i18nMap).map(([en, pl]) => [pl, en])
);

function getAlternates(path: string): { en: string; pl: string } | null {
  const normalized = path.endsWith('/') ? path : path + '/';
  if (normalized in i18nMap) return { en: normalized, pl: i18nMap[normalized] };
  if (normalized in i18nMapReverse) return { en: i18nMapReverse[normalized], pl: normalized };
  return null;
}

const alternates = getAlternates(canonicalPath);
const ogLocale = lang === 'pl' ? 'pl_PL' : 'en_US';

/* JSON-LD structured data */
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "inLanguage": lang,
  "isPartOf": {
    "@type": "WebSite",
    "name": "Vibecrafted",
    "url": siteUrl,
    "publisher": {
      "@type": "Organization",
      "name": "VetCoders",
      "url": "https://github.com/VetCoders"
    }
  }
});

/* Locale-aware nav helpers */
const isPl = lang === 'pl';
const normalizedPath = canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`;
const toggleLang = isPl ? 'EN' : 'PL';
const toggleHref = alternates
  ? (isPl ? alternates.en : alternates.pl)
  : (isPl ? '/' : '/pl/');
const toggleHreflang = isPl ? 'en' : 'pl';

/* Locale-aware paths for nav & footer */
const navPaths = {
  home: isPl ? '/pl/' : '/en/',
  demo: isPl ? '/pl/framework/' : '/en/framework/',
  quickstart: isPl ? '/pl/quickstart/' : '/en/quickstart/',
  faq: isPl ? '/pl/faq/' : '/en/faq/',
};

const isHomePage = normalizedPath === navPaths.home;
const isDocsPage = normalizedPath === navPaths.quickstart || normalizedPath === navPaths.faq;
const isFrameworkPage = normalizedPath === navPaths.demo;

const sectionLinks = {
  pipeline: isHomePage ? '#pipeline' : `${navPaths.home}#pipeline`,
  skills: isHomePage ? '#skills' : `${navPaths.home}#skills`,
  marbles: isHomePage ? '#marbles' : `${navPaths.home}#marbles`,
  dou: isHomePage ? '#dou' : `${navPaths.home}#dou`,
  get: '#get',
};

/* Locale-aware labels */
const navLabels = isPl
  ? {
      pipeline: 'Pipeline',
      skills: 'Skille',
      marbles: 'Marbles',
      marblesFooter: 'Konwergencja Marbles',
      demo: 'Demo',
      quickstart: 'Szybki start',
      faq: 'FAQ',
      dou: 'DoU',
      douFooter: 'Deklaracja użycia',
      get: 'Pobierz',
      system: 'System',
      resources: 'Zasoby',
      project: 'Projekt',
      foundation: 'Fundament',
      github: 'Repozytorium GitHub',
      license: 'Licencja (BSL 1.1)',
      security: 'Bezpieczeństwo',
      skip: 'Przejdź do treści',
      switchLang: 'Switch to English',
      menu: 'Menu',
      closeMenu: 'Zamknij menu',
      navPrimary: 'Nawigacja główna',
      navFooter: 'Nawigacja stopki',
    }
  : {
      pipeline: 'Pipeline',
      skills: 'Skills',
      marbles: 'Marbles',
      marblesFooter: 'Marbles Convergence',
      demo: 'Demo',
      quickstart: 'Quick Start',
      faq: 'FAQ',
      dou: 'DoU',
      douFooter: 'Declaration of Usage',
      get: 'Get',
      system: 'System',
      resources: 'Resources',
      project: 'Project',
      foundation: 'Foundation',
      github: 'GitHub Repository',
      license: 'License (BSL 1.1)',
      security: 'Security',
      skip: 'Skip to content',
      switchLang: 'Przełącz na polski',
      menu: 'Menu',
      closeMenu: 'Close menu',
      navPrimary: 'Primary navigation',
      navFooter: 'Footer navigation',
    };

const inlineScriptHashes = [
  "'sha256-Q2BPg90ZMplYY+FSdApNErhpWafg2hcRRbndmvxuL/Q='",
  "'sha256-QJZDUlo/qa5AJCrG6vHyWcatjwCeWidEHQfJc601lzw='",
  "'sha256-eIXWvAmxkr251LJZkjniEK5LcPF3NkapbJepohwYRIc='",
  "'sha256-CGXPR4h8KhiD2d5ZEMGdIVoEsY5O4BhcHcTENCtCt40='",
  "'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c='",
].join(' ');

const contentSecurityPolicy = [
  "default-src 'none'",
  `script-src 'self' https://cdn.jsdelivr.net https://plausible.io ${inlineScriptHashes}`,
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "img-src 'self' data:",
  "font-src 'self' https://fonts.gstatic.com",
  "connect-src 'self' https://plausible.io",
  "frame-src 'none'",
  "worker-src 'self'",
  "manifest-src 'self'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---

<!DOCTYPE html>
<html lang={lang} class:list={[isDocsPage && 'subpage']}>
<head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>{title}</title>
    <meta content={description} name="description">
    <meta content={title} property="og:title">
    <meta content={description} property="og:description">
    <meta content={ogImageUrl} property="og:image">
    <meta content="1536" property="og:image:width">
    <meta content="1024" property="og:image:height">
    <meta content="image/png" property="og:image:type">
    <meta content={description ?? title} property="og:image:alt">
    <meta content={ogType} property="og:type">
    <meta content={canonicalUrl} property="og:url">
    <meta content="Vibecrafted" property="og:site_name">
    <meta content={ogLocale} property="og:locale">
    {alternates && <meta content={lang === 'pl' ? 'en_US' : 'pl_PL'} property="og:locale:alternate" />}
    <meta content="summary_large_image" name="twitter:card">
    <meta content={title} name="twitter:title">
    <meta content={description} name="twitter:description">
    <meta content={ogImageUrl} name="twitter:image">
    <meta content={description ?? title} name="twitter:image:alt">
    <meta content="@VetCoders" name="twitter:site">
    <meta content="T5B-vRPBGSbPiROhDSZPMplZ6bA5yCgT_3egIGQ8kIE" name="google-site-verification">
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy}>
    <meta content={robotsContent} name="robots">
    <meta content="#0e0e11" name="theme-color">
    <link href={canonicalUrl} rel="canonical">
    {alternates && <>
      <link href={new URL(alternates.en, siteUrl).href} hreflang="en" rel="alternate" />
      <link href={new URL(alternates.pl, siteUrl).href} hreflang="pl" rel="alternate" />
      <link href={new URL(alternates.en, siteUrl).href} hreflang="x-default" rel="alternate" />
    </>}
    <link href="/presence/favicon.ico" rel="icon" sizes="32x32">
    <link href="/presence/logo-64.png" rel="icon" sizes="64x64" type="image/png">
    <link href="/presence/logo-128.png" rel="apple-touch-icon">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Allura&family=Poppins:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <script is:inline crossorigin="anonymous" integrity="sha384-7Q8XaCgFJlm82NdMNnX7AIyZbdTjUre2eR4TpKK1Pko3zKXorgTIGVpnnLho+UAe" src="https://cdn.jsdelivr.net/npm/mermaid@10.8.0/dist/mermaid.min.js"></script>
    <script is:inline defer data-domain="vibecrafted.io" src="https://plausible.io/js/script.js"></script>
</head>
<body class:list={[isDocsPage && 'docs-page', isFrameworkPage && 'framework-page']}>
    <a class="skip-link" href="#main-content">{navLabels.skip}</a>

    <div class="topbar">
        <header class="nav-shell" data-nav-open="false" data-nav-shell>
            <a class="brand" data-astro-reload href={navPaths.home}>
                <span class="brand-wordmark">vibecrafted</span>
                <Image
                    src={logo32}
                    alt=""
                    aria-hidden="true"
                    class="brand-logo"
                    width={24}
                    height={24}
                    densities={[1, 2]}
                    format="webp"
                />
            </a>
            <button
                aria-controls="site-nav"
                aria-expanded="false"
                aria-label={navLabels.menu}
                class="nav-toggle"
                data-closed-label={navLabels.menu}
                data-nav-toggle
                data-open-label={navLabels.closeMenu}
                type="button"
            >
                <span class="nav-toggle__label">{navLabels.menu}</span>
                <span aria-hidden="true" class="nav-toggle__glyph">
                    <span></span>
                    <span></span>
                </span>
            </button>
            <nav aria-label={navLabels.navPrimary} class="nav-links" data-nav-panel id="site-nav">
                <a href={sectionLinks.pipeline}>{navLabels.pipeline}</a>
                <a href={sectionLinks.skills}>{navLabels.skills}</a>
                <a href={sectionLinks.marbles}>{navLabels.marbles}</a>
                <a data-astro-reload href={navPaths.demo}>{navLabels.demo}</a>
                <a data-astro-reload data-modal-open={isHomePage ? 'quickstart-modal' : undefined} href={navPaths.quickstart}>{navLabels.quickstart}</a>
                <a data-astro-reload data-modal-open={isHomePage ? 'faq-modal' : undefined} href={navPaths.faq}>{navLabels.faq}</a>
                <a href={sectionLinks.dou}>{navLabels.dou}</a>
                <div class="nav-get-zone">
                    <a href={sectionLinks.get} id="nav-get-link">{navLabels.get}</a>
                    <a data-astro-reload href={toggleHref} hreflang={toggleHreflang} lang={toggleHreflang} aria-label={navLabels.switchLang}>{toggleLang}</a>
                    <a aria-label="GitHub" class="nav-icon-link" href="https://github.com/VetCoders/vibecrafted" rel="noopener noreferrer">
                        <svg aria-hidden="true" class="nav-icon" viewBox="0 0 24 24">
                            <path d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.53.1.72-.23.72-.51v-1.81c-2.94.64-3.56-1.24-3.56-1.24-.48-1.22-1.16-1.55-1.16-1.55-.95-.65.07-.63.07-.63 1.05.07 1.6 1.08 1.6 1.08.94 1.6 2.45 1.14 3.04.87.09-.68.37-1.14.66-1.4-2.35-.27-4.82-1.18-4.82-5.25 0-1.16.41-2.1 1.08-2.84-.11-.27-.47-1.36.1-2.83 0 0 .88-.28 2.89 1.08a10.08 10.08 0 0 1 5.26 0c2-1.36 2.88-1.08 2.88-1.08.58 1.47.22 2.56.11 2.83.67.74 1.08 1.68 1.08 2.84 0 4.08-2.48 4.97-4.85 5.23.38.33.72.97.72 1.95v2.89c0 .28.19.62.73.51A10.5 10.5 0 0 0 12 1.5Z"></path>
                        </svg>
                    </a>
                </div>
            </nav>
        </header>
    </div>

    <div class="curl-banner" id="get">
        <code><span class="cb-g">$</span> curl -fsSL https://vibecrafted.io/install.sh | bash</code>
        <CopyButton client:visible class="cb-copy" textToCopy="curl -fsSL https://vibecrafted.io/install.sh | bash" defaultLabel={isPl ? 'Kopiuj' : 'Copy'} copiedLabel={isPl ? 'Skopiowano!' : 'Copied!'} />
    </div>

    <main class="shell" id="main-content">
        <slot />
    </main>

    <footer class="footer-shell" aria-label="Site footer">
        <div class="footer-brand">
            <Image
                src={logo32}
                alt=""
                aria-hidden="true"
                class="footer-logo"
                width={24}
                height={24}
                densities={[1, 2]}
                format="webp"
            />
            <span class="footer-title">VIBECRAFTED</span>
            <p class="footer-tagline">𝗕𝘂𝗶𝗹𝘁 𝘂𝗻𝗱𝗲𝗿 ᵐⁱᵈⁿⁱᵍʰᵗ 𝗽𝗿𝗲𝘀𝘀𝘂𝗿𝗲. 𝗗𝗲𝗽𝗹𝗼𝘆𝗲𝗱 𝘁𝗼 ˡᵒᶜᵃˡʰᵒˢᵗ.</p>
        </div>
        
        <nav class="footer-links" aria-label={navLabels.navFooter}>
            <div class="footer-col">
                <h4>{navLabels.system}</h4>
                <a href={sectionLinks.pipeline}>{navLabels.pipeline}</a>
                <a href={sectionLinks.skills}>{navLabels.skills}</a>
                <a href={sectionLinks.marbles}>{navLabels.marblesFooter}</a>
            </div>
            <div class="footer-col">
                <h4>{navLabels.resources}</h4>
                <a data-astro-reload data-modal-open={isHomePage ? 'quickstart-modal' : undefined} href={navPaths.quickstart}>{navLabels.quickstart}</a>
                <a data-astro-reload data-modal-open={isHomePage ? 'faq-modal' : undefined} href={navPaths.faq}>{navLabels.faq}</a>
                <a href="https://github.com/VetCoders/vibecrafted/blob/main/docs/FOUNDATION.md" rel="noopener noreferrer">{navLabels.foundation}</a>
            </div>
            <div class="footer-col">
                <h4>{navLabels.project}</h4>
                <a href="https://github.com/VetCoders/vibecrafted" rel="noopener noreferrer">{navLabels.github}</a>
                <a href="https://github.com/VetCoders/vibecrafted/blob/main/LICENSE" rel="noopener noreferrer">{navLabels.license}</a>
                <a href="https://github.com/VetCoders/vibecrafted/blob/main/SECURITY.md" rel="noopener noreferrer">{navLabels.security}</a>
            </div>
        </nav>
        
        <div class="footer-bottom">
            <div class="footer-legal">
                <span>&copy; 2026 VetCoders</span>
                <span class="footer-brands">
                    <span class="brand-badge">Built for Apple Silicon</span>
                    <span class="brand-badge">Powered by OpenAI</span>
                </span>
            </div>
            <div class="footer-bottom-links">
                <a href={sectionLinks.dou}>{navLabels.douFooter}</a>
            </div>
        </div>
    </footer>

    <script is:inline>
        const mobileNavMedia = '(max-width: 720px)';

        function initMobileNav() {
            window.__vcNavCleanup?.();

            const shell = document.querySelector('[data-nav-shell]');
            const toggle = document.querySelector('[data-nav-toggle]');
            const panel = document.querySelector('[data-nav-panel]');

            if (!(shell instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) {
                return;
            }

            const label = toggle.querySelector('.nav-toggle__label');
            const closedLabel = toggle.dataset.closedLabel ?? 'Menu';
            const openLabel = toggle.dataset.openLabel ?? 'Close';
            const media = window.matchMedia(mobileNavMedia);

            const setOpen = (open) => {
                shell.dataset.navOpen = open ? 'true' : 'false';
                toggle.setAttribute('aria-expanded', String(open));
                toggle.setAttribute('aria-label', open ? openLabel : closedLabel);
                if (label) {
                    label.textContent = open ? openLabel : closedLabel;
                }
                document.body.classList.toggle('nav-open', open && media.matches);
            };

            const closeNav = () => setOpen(false);

            if (toggle.dataset.navBound === 'true') {
                setOpen(shell.dataset.navOpen === 'true' && media.matches);
                return;
            }

            toggle.dataset.navBound = 'true';
            setOpen(false);

            toggle.addEventListener('click', () => {
                setOpen(shell.dataset.navOpen !== 'true');
            });

            panel.querySelectorAll('a').forEach((link) => {
                link.addEventListener('click', () => {
                    if (media.matches) {
                        closeNav();
                    }
                });
            });

            const handleKeydown = (event) => {
                if (event.key === 'Escape') {
                    closeNav();
                }
            };

            const handleMediaChange = () => {
                if (!media.matches) {
                    closeNav();
                }
            };

            document.addEventListener('keydown', handleKeydown);
            media.addEventListener('change', handleMediaChange);

            window.__vcNavCleanup = () => {
                document.removeEventListener('keydown', handleKeydown);
                media.removeEventListener('change', handleMediaChange);
                document.body.classList.remove('nav-open');
            };
        }

        document.addEventListener('astro:page-load', initMobileNav);
        initMobileNav();
    </script>
    <ScrollObserver client:load />
    <CardStrip client:load />
</body>
</html>
