---
/**
 * LayoutV2.astro — thin shell for the V2 landing redesign.
 *
 * Coexists with Layout.astro (legacy). Subpages and legacy landing continue
 * to use Layout.astro. Only the new V2 landing (`/`, `/en/`, `/pl/`) uses
 * LayoutV2.
 *
 * Loads: Instrument Serif (display) + Inter (body) + JetBrains Mono (code).
 * Sets `.v2-scope` on <body> so `styles/tokens-v2.css` tokens apply.
 * No nav/footer baked in — the page owns layout (handoff § 3.2: Nav is
 * absolute positioned inside Hero section, not a global top bar).
 */
import { ClientRouter } from 'astro:transitions';
import type { Lang } from '../lib/i18n';
import '../styles/tokens-v2.css';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = 'Release engine for AI-built software. Ship AI-built software without the vibe hangover.',
  lang = 'en',
  ogImage = '/presence/og-image.png',
  ogType = 'website',
} = Astro.props as Props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://vibecrafted.io';
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '/');
const canonicalUrl = new URL(canonicalPath || '/', siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
const ogLocale = lang === 'pl' ? 'pl_PL' : 'en_US';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalUrl,
  inLanguage: lang,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Vibecrafted',
    url: siteUrl,
    publisher: {
      '@type': 'Organization',
      name: 'VetCoders',
      url: 'https://github.com/VetCoders',
    },
  },
});
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <ClientRouter />
  <meta charset="UTF-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>{title}</title>
  <meta content={description} name="description" />
  <meta content={title} property="og:title" />
  <meta content={description} property="og:description" />
  <meta content={ogImageUrl} property="og:image" />
  <meta content="1536" property="og:image:width" />
  <meta content="1024" property="og:image:height" />
  <meta content="image/png" property="og:image:type" />
  <meta content={description} property="og:image:alt" />
  <meta content={ogType} property="og:type" />
  <meta content={canonicalUrl} property="og:url" />
  <meta content="Vibecrafted" property="og:site_name" />
  <meta content={ogLocale} property="og:locale" />
  <meta content="summary_large_image" name="twitter:card" />
  <meta content={title} name="twitter:title" />
  <meta content={description} name="twitter:description" />
  <meta content={ogImageUrl} name="twitter:image" />
  <meta content={description} name="twitter:image:alt" />
  <meta content="@VetCoders" name="twitter:site" />
  <meta content="index,follow" name="robots" />
  <meta content="#0e0e0c" name="theme-color" />
  <meta
    http-equiv="Content-Security-Policy"
    content={[
      "default-src 'none'",
      "script-src 'self' 'unsafe-inline' https://plausible.io",
      "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
      "style-src-attr 'unsafe-inline'",
      "img-src 'self' data:",
      "font-src 'self' https://fonts.gstatic.com",
      "connect-src 'self' https://plausible.io",
      "frame-src 'none'",
      "worker-src 'self'",
      "manifest-src 'self'",
      "base-uri 'self'",
      "form-action 'self'",
    ].join('; ')}
  />
  <link href={canonicalUrl} rel="canonical" />
  <link href="/presence/favicon.ico" rel="icon" sizes="32x32" />
  <link href="/presence/logo-64.png" rel="icon" sizes="64x64" type="image/png" />
  <link href="/presence/logo-128.png" rel="apple-touch-icon" />
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400..800;1,400..800&display=swap"
    rel="stylesheet"
  />

  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <script is:inline defer data-domain="vibecrafted.io" src="https://plausible.io/js/script.js"></script>
</head>
<body class="v2-scope" data-lang={lang}>
  <slot />
</body>
</html>

<style is:global>
  /* ── V2 body baseline ───────────────────────────────────── */
  body.v2-scope {
    margin: 0;
    padding: 0;
    background: var(--v2-ink);
    color: var(--v2-fg-on-dark);
    font-family: var(--v2-font-body);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  /* Scroll behavior for anchor navigation (nav links → #about, #framework, etc.) */
  html:has(body.v2-scope) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html:has(body.v2-scope) {
      scroll-behavior: auto;
    }
  }
  body.v2-scope [id] {
    scroll-margin-top: 96px;
  }

  /* Reset for any element that might end up inside V2 content */
  body.v2-scope * {
    box-sizing: border-box;
  }
  body.v2-scope img,
  body.v2-scope svg,
  body.v2-scope canvas {
    display: block;
    max-width: 100%;
  }
  body.v2-scope a {
    color: inherit;
    text-decoration: none;
  }
  body.v2-scope button {
    font-family: inherit;
    cursor: pointer;
  }
</style>
