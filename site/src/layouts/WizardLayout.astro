---
import { Image } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import logo32 from '../assets/presence/logo-32.png';
import { getTranslations } from '../lib/i18n';
import '../styles/global.css';
import '../styles/tokens-v2.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'pl';
}

const { title, description, lang = 'en' } = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://vibecrafted.io';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL('/presence/og-image.png', siteUrl).href;
const ogLocale = lang === 'pl' ? 'pl_PL' : 'en_US';
const dict = getTranslations(lang);
const navLabels = dict.nav;
const footer = dict.footer;
const wizardLayoutCopy = dict.sections.wizardLayout;
const resolvedDescription = description ?? wizardLayoutCopy.defaultDescription;
const basePath = `/${lang}`;
const otherLang = lang === 'pl' ? 'en' : 'pl';
const homeHref = `${basePath}/`;
const quickstartHref = `${basePath}/quickstart/`;
const faqHref = `${basePath}/faq/`;
const toggleHref = `/${otherLang}/install/`;
const toggleLang = otherLang;
const closeInstallerLabel = wizardLayoutCopy.closeInstaller;
const closeInstallerShort = wizardLayoutCopy.closeInstallerShort;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <ClientRouter />
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>{title}</title>
    <meta content={resolvedDescription} name="description">
    <meta content={title} property="og:title">
    <meta content={resolvedDescription} property="og:description">
    <meta content={ogImageUrl} property="og:image">
    <meta content="website" property="og:type">
    <meta content={canonicalUrl} property="og:url">
    <meta content="Vibecrafted" property="og:site_name">
    <meta content={ogLocale} property="og:locale">
    <meta content="summary_large_image" name="twitter:card">
    <meta content={title} name="twitter:title">
    <meta content={resolvedDescription} name="twitter:description">
    <meta content={ogImageUrl} name="twitter:image">
    <meta content="@VetCoders" name="twitter:site">
    <meta content="index,follow" name="robots">
    <meta content="#0e0e11" name="theme-color">
    <link href={canonicalUrl} rel="canonical">
    <link href="/presence/favicon.ico" rel="icon" sizes="32x32">
    <link href="/presence/logo-64.png" rel="icon" sizes="64x64" type="image/png">
    <link href="/presence/logo-128.png" rel="apple-touch-icon">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400..800;1,400..800&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    <script is:inline defer data-domain="vibecrafted.io" src="https://plausible.io/js/script.js"></script>
    <style>
      html, body {
        margin: 0;
        padding: 0;
        min-height: 100dvh;
        overflow-x: hidden;
        background: var(--stone-deep, #0e0e11);
      }
    </style>
</head>
<body class="wizard-page v2-scope">
    <main class="wizard-shell">
        <div
            class="wizard-shell__backdrop"
            aria-hidden="true"
            data-installer-close
            data-close-target={homeHref}
        ></div>
        <div class="wizard-shell__frame">
            <header class="wizard-shell__topbar vt-site-topbar">
                <a class="brand" href={homeHref}>
                    <span class="brand-mark vt-site-brand" transition:persist>
                        <span class="brand-wordmark">𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍.</span>
                        <Image
                            src={logo32}
                            alt=""
                            aria-hidden="true"
                            class="brand-logo"
                            width={24}
                            height={24}
                            densities={[1, 2]}
                            format="webp"
                        />
                    </span>
                </a>
                <nav class="wizard-shell__links" aria-label={navLabels.navPrimary}>
                    <a href={quickstartHref}>{navLabels.quickstart}</a>
                    <a href={faqHref}>{navLabels.faq}</a>
                    <a href={toggleHref} hreflang={toggleLang} lang={toggleLang}>{navLabels.toggleShort}</a>
                    <a
                        href={homeHref}
                        aria-label={closeInstallerLabel}
                        class="wizard-close-btn"
                        title={closeInstallerLabel}
                        data-installer-close
                        data-close-target={homeHref}
                        data-astro-reload
                    >
                        <span class="wizard-close-btn__label">{closeInstallerShort}</span>
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </a>
                </nav>
            </header>
            <div class="wizard-shell__content">
                <slot />
            </div>
            <footer class="footer-shell footer-shell--wizard vt-site-footer" aria-label={footer.ariaLabel}>
                <div class="footer-container footer-container--wizard">
                    <div class="footer-brand vt-site-footer-brand" transition:persist>
                        <Image
                            src={logo32}
                            alt=""
                            aria-hidden="true"
                            class="footer-logo"
                            width={24}
                            height={24}
                            densities={[1, 2]}
                            format="webp"
                        />
                        <span class="footer-title footer-wordmark">{footer.brand}</span>
                    </div>
                    <div class="footer-meta">
                        <span class="footer-tagline">{footer.byline}</span>
                        <span class="footer-meta-sep" aria-hidden="true">·</span>
                        <span class="footer-copyright">{footer.copyright}</span>
                        <span class="footer-meta-sep" aria-hidden="true">·</span>
                        <span class="footer-license">{footer.license}</span>
                    </div>
                </div>
            </footer>
        </div>
    </main>
    <script is:inline define:vars={{ homeHref }}>
      const closePath = homeHref;
      const closeEvent = 'vibecrafted-installer:closing';
      let closing = false;

      async function closeInstaller(targetHref) {
        if (closing) return;
        closing = true;

        window.dispatchEvent(new CustomEvent(closeEvent));

        if (window.__VIBECRAFTED_LIVE__ === true) {
          try {
            await Promise.race([
              fetch('/api/session', {
                method: 'DELETE',
                headers: { Accept: 'application/json' },
                cache: 'no-store',
                keepalive: true,
              }),
              new Promise((resolve) => window.setTimeout(resolve, 450)),
            ]);
          } catch {}
        }

        window.location.assign(targetHref);
      }

      document.addEventListener(
        'click',
        (event) => {
          if (!(event.target instanceof Element)) return;
          const trigger = event.target.closest('[data-installer-close]');
          if (!trigger) return;
          event.preventDefault();
          event.stopPropagation();
          closeInstaller(trigger.getAttribute('data-close-target') || closePath);
        },
        { capture: true }
      );
    </script>
</body>
</html>

<style is:global>
  .vt-site-topbar {
    view-transition-name: site-topbar;
  }

  .vt-site-brand {
    view-transition-name: site-brand;
  }

  .vt-site-footer {
    view-transition-name: site-footer;
  }

  .vt-site-footer-brand {
    view-transition-name: site-footer-brand;
  }

  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-old(root) {
      animation-duration: 0.22s;
      animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
    }

    ::view-transition-new(root) {
      animation-duration: 0.34s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    ::view-transition-group(site-topbar),
    ::view-transition-group(site-footer) {
      animation-duration: 0.3s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    ::view-transition-group(site-brand),
    ::view-transition-group(site-footer-brand) {
      animation-duration: 0.5s;
      animation-timing-function: cubic-bezier(0.18, 1, 0.3, 1);
    }

    ::view-transition-old(site-topbar),
    ::view-transition-new(site-topbar),
    ::view-transition-old(site-brand),
    ::view-transition-new(site-brand),
    ::view-transition-old(site-footer-brand),
    ::view-transition-new(site-footer-brand) {
      animation-timing-function: cubic-bezier(0.18, 1, 0.3, 1);
    }

    ::view-transition-old(site-topbar),
    ::view-transition-new(site-topbar),
    ::view-transition-old(site-footer),
    ::view-transition-new(site-footer) {
      animation-duration: 0.3s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  html,
  body {
    margin: 0;
    min-height: 100dvh;
  }

  body.wizard-page {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(0.8rem, 2vw, 1.35rem);
    overflow-x: hidden;
    overflow-y: auto;
    isolation: isolate;
    --font-head: var(--v2-font-display, "Instrument Serif", "Times New Roman", serif);
    --font-body: var(--v2-font-body, "Inter", system-ui, -apple-system, sans-serif);
    --font-mono: var(--v2-font-mono, "JetBrains Mono", ui-monospace, monospace);
    --copper: var(--v2-accent, #cf6f4e);
    --copper-bright: #d09a83;
    --stone-deep: var(--v2-ink, #080807);
    --steel-edge: var(--v2-fg-on-dark, #f5f4ef);
    --steel-dark: var(--v2-fg-on-dark-mute, rgba(245, 244, 239, 0.42));
    --steel-border-soft: var(--v2-rule-dark, rgba(245, 244, 239, 0.12));
    color: var(--v2-fg-on-dark, #f5f4ef);
    background:
      linear-gradient(180deg, rgba(8, 8, 7, 0.98), rgba(15, 14, 13, 0.98) 48%, rgba(8, 8, 7, 0.99)),
      var(--stone-deep, #080807);
  }

  body.wizard-page::before,
  body.wizard-page::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  body.wizard-page::before {
    background:
      linear-gradient(90deg, rgba(245, 244, 239, 0.04) 1px, transparent 1px),
      linear-gradient(180deg, rgba(245, 244, 239, 0.035) 1px, transparent 1px);
    background-size: 84px 84px;
    opacity: 0.24;
    mask-image: linear-gradient(180deg, transparent, #000 22%, #000 78%, transparent);
  }

  body.wizard-page::after {
    background:
      linear-gradient(180deg, rgba(8, 8, 7, 0.1), rgba(8, 8, 7, 0.68)),
      linear-gradient(90deg, rgba(245, 244, 239, 0.035), transparent 32%, transparent 70%, rgba(61, 122, 114, 0.08));
  }

  .wizard-shell {
    position: relative;
    z-index: 1;
    width: min(100%, 76rem);
    height: auto;
    min-height: calc(100dvh - clamp(1.6rem, 4vw, 2.7rem));
  }

  .wizard-shell__backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  .wizard-shell::before,
  .wizard-shell::after {
    content: "";
    position: absolute;
    pointer-events: none;
    border-radius: 999px;
    filter: blur(42px);
    display: none;
    opacity: 0;
  }

  .wizard-shell::before {
    width: 16rem;
    height: 16rem;
    top: -2rem;
    right: 8%;
    background: rgba(61, 122, 114, 0.14);
  }

  .wizard-shell::after {
    width: 14rem;
    height: 14rem;
    bottom: -2.5rem;
    left: 10%;
    background: rgba(90, 138, 122, 0.16);
  }

  .wizard-shell__frame {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    height: auto;
    min-height: inherit;
    border: 1px solid rgba(196, 212, 224, 0.16);
    border-radius: clamp(0.5rem, 1.4vw, 0.9rem);
    background:
      linear-gradient(180deg, rgba(13, 13, 12, 0.96), rgba(8, 8, 7, 0.99)),
      linear-gradient(90deg, rgba(245, 244, 239, 0.035), transparent 34%, rgba(61, 122, 114, 0.07));
    box-shadow:
      0 32px 80px rgba(0, 0, 0, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    overflow: visible;
  }

  .wizard-shell__frame::before,
  .wizard-shell__frame::after {
    content: "";
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    height: 1px;
    pointer-events: none;
  }

  .wizard-shell__frame::before {
    top: 0;
    background: linear-gradient(90deg, rgba(245, 244, 239, 0), rgba(245, 244, 239, 0.2), rgba(61, 122, 114, 0.18), rgba(245, 244, 239, 0));
  }

  .wizard-shell__frame::after {
    bottom: 0;
    background: linear-gradient(90deg, rgba(163, 184, 199, 0), rgba(163, 184, 199, 0.18), rgba(61, 122, 114, 0.16), rgba(163, 184, 199, 0));
  }

  .wizard-shell__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1rem 0.65rem;
    border-bottom: 1px solid rgba(245, 244, 239, 0.12);
    background:
      linear-gradient(180deg, rgba(23, 22, 21, 0.94), rgba(12, 12, 11, 0.78));
    backdrop-filter: blur(18px) saturate(118%);
    -webkit-backdrop-filter: blur(18px) saturate(118%);
  }

  .wizard-shell__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem 0.8rem;
    align-items: center;
  }

  .wizard-shell__links a {
    color: rgba(245, 244, 239, 0.7);
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .wizard-shell__links a:hover,
  .wizard-shell__links a:focus-visible {
    color: rgba(245, 244, 239, 0.94);
    transform: translateY(-1px);
  }

  .wizard-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-left: 0.5rem;
    padding: 0.36rem 0.68rem;
    border-radius: 0;
    background:
      linear-gradient(180deg, rgba(var(--v2-paper-rgb), 0.05), transparent),
      rgba(var(--v2-paper-rgb), 0.035);
    border: 1px solid rgba(245, 244, 239, 0.12);
    color: rgba(245, 244, 239, 0.72);
    cursor: pointer;
    backdrop-filter: var(--paper-backdrop, blur(18px) saturate(0.92) contrast(0.96));
    -webkit-backdrop-filter: var(--paper-backdrop, blur(18px) saturate(0.92) contrast(0.96));
    transition: all 0.18s ease;
  }

  .wizard-close-btn__label {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .wizard-close-btn:hover,
  .wizard-close-btn:focus-visible {
    background: rgba(245, 244, 239, 0.1) !important;
    border-color: rgba(245, 244, 239, 0.28) !important;
    color: rgba(245, 244, 239, 0.94) !important;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--steel-edge);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: inherit;
    border: 1px solid rgba(245, 244, 239, 0.12);
    border-radius: 0;
    padding: 0.2rem 0.44rem;
    background:
      linear-gradient(180deg, rgba(var(--v2-paper-rgb), 0.04), transparent),
      rgba(8, 8, 7, 0.3);
    backdrop-filter: var(--paper-backdrop, blur(18px) saturate(0.92) contrast(0.96));
    -webkit-backdrop-filter: var(--paper-backdrop, blur(18px) saturate(0.92) contrast(0.96));
    box-shadow:
      inset 0 1px 0 rgba(245, 244, 239, 0.08),
      0 10px 24px rgba(0, 0, 0, 0.18);
    transition:
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.22s ease;
  }

  .brand:hover .brand-mark,
  .brand:focus-visible .brand-mark {
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(229, 236, 245, 0.24),
      0 12px 28px rgba(0, 0, 0, 0.2);
  }

  .brand-wordmark {
    color: var(--steel-edge);
    font-family: var(--font-head, 'Fraunces', serif);
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .brand-logo {
    margin-left: 0;
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--steel-border-soft);
  }

  .wizard-shell__content {
    flex: 1 0 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .footer-shell {
    width: 100%;
    margin: 0;
    padding: var(--footer-shell-padding);
    border: 0;
    border-radius: 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--footer-shell-gap);
    position: relative;
    overflow: visible;
    isolation: isolate;
    box-shadow: none;
  }

  .footer-shell--wizard {
    margin-top: 0;
    border-top: 1px solid rgba(245, 244, 239, 0.1);
    background:
      linear-gradient(180deg, rgba(12, 12, 11, 0.7), rgba(8, 8, 7, 0.94));
  }

  .footer-container--wizard {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 0.52rem;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.72rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    color: var(--steel-edge);
    font-family: var(--font-mono);
  }

  .footer-logo {
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--steel-border-soft);
  }

  .footer-title {
    color: var(--steel-edge);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .footer-wordmark {
    text-transform: none;
    letter-spacing: normal;
  }

  .footer-meta {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--steel-dark);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.35;
  }

  .footer-tagline {
    margin: 0;
    max-width: none;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: 0.04em;
    line-height: inherit;
    text-align: right;
    text-transform: none;
  }

  .footer-meta-sep {
    color: rgba(163, 184, 199, 0.56);
  }

  .footer-license {
    letter-spacing: 0.08em;
    text-transform: none;
  }

  .footer-copyright {
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: none;
  }

  @media (max-width: 720px) {
    body.wizard-page {
      padding: 0;
    }

    .wizard-shell {
      width: 100%;
      height: auto;
      min-height: 100dvh;
    }

    .wizard-shell__frame {
      border-left: 0;
      border-right: 0;
      border-radius: 0;
      min-height: 100dvh;
    }

    .wizard-shell__topbar {
      align-items: flex-start;
      padding: 0.9rem 0.95rem 0.6rem;
    }

    .wizard-shell__links {
      gap: 0.35rem 0.58rem;
    }

    .wizard-shell__links a {
      font-size: 0.64rem;
      letter-spacing: 0.06em;
    }

    .wizard-close-btn {
      margin-left: 0;
      padding: 0.42rem;
    }

    .wizard-close-btn__label {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .brand {
      gap: 0.45rem;
    }

    .brand-wordmark {
      font-size: 0.84rem;
      letter-spacing: 0;
    }

    .footer-container--wizard {
      flex-direction: column;
      padding-inline: 0.95rem;
      padding-block: 0.48rem;
      gap: 0.28rem;
    }

    .footer-meta {
      display: none;
    }

    .footer-meta {
      justify-content: center;
      text-align: center;
    }

    .footer-tagline {
      text-align: center;
    }
  }
</style>
