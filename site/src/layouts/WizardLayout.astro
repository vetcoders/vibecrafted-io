---
import { Image } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import logo32 from '../assets/presence/logo-32.png';
import { getTranslations } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'pl';
}

const {
  title,
  description = 'Guided installer for the Vibecrafted release engine.',
  lang = 'en',
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://vibecrafted.io';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL('/presence/og-image.png', siteUrl).href;
const ogLocale = lang === 'pl' ? 'pl_PL' : 'en_US';
const dict = getTranslations(lang);
const navLabels = dict.nav;
const footer = dict.footer;
const isPl = lang === 'pl';
const homeHref = isPl ? '/pl/' : '/en/';
const quickstartHref = isPl ? '/pl/quickstart/' : '/en/quickstart/';
const faqHref = isPl ? '/pl/faq/' : '/en/faq/';
const toggleHref = isPl ? '/en/install/' : '/pl/install/';
const toggleLang = isPl ? 'en' : 'pl';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <ClientRouter />
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>{title}</title>
    <meta content={description} name="description">
    <meta content={title} property="og:title">
    <meta content={description} property="og:description">
    <meta content={ogImageUrl} property="og:image">
    <meta content="website" property="og:type">
    <meta content={canonicalUrl} property="og:url">
    <meta content="Vibecrafted" property="og:site_name">
    <meta content={ogLocale} property="og:locale">
    <meta content="summary_large_image" name="twitter:card">
    <meta content={title} name="twitter:title">
    <meta content={description} name="twitter:description">
    <meta content={ogImageUrl} name="twitter:image">
    <meta content="@VetCoders" name="twitter:site">
    <meta content="index,follow" name="robots">
    <meta content="#0e0e11" name="theme-color">
    <link href={canonicalUrl} rel="canonical">
    <link href="/presence/favicon.ico" rel="icon" sizes="32x32">
    <link href="/presence/logo-64.png" rel="icon" sizes="64x64" type="image/png">
    <link href="/presence/logo-128.png" rel="apple-touch-icon">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script is:inline defer data-domain="vibecrafted.io" src="https://plausible.io/js/script.js"></script>
    <style>
      html, body {
        margin: 0;
        padding: 0;
        height: 100dvh;
        overflow: hidden;
        background: var(--stone-deep, #0e0e11);
      }
    </style>
</head>
<body class="wizard-page">
    <main class="wizard-shell">
        <div class="wizard-shell__frame">
            <header class="wizard-shell__topbar" transition:name="site-topbar">
                <a class="brand" href={homeHref}>
                    <span class="brand-mark" transition:name="site-brand" transition:persist>
                        <span class="brand-wordmark">vibecrafted</span>
                        <Image
                            src={logo32}
                            alt=""
                            aria-hidden="true"
                            class="brand-logo"
                            width={24}
                            height={24}
                            densities={[1, 2]}
                            format="webp"
                        />
                    </span>
                </a>
                <nav class="wizard-shell__links" aria-label={navLabels.navPrimary}>
                    <a href={quickstartHref}>{navLabels.quickstart}</a>
                    <a href={faqHref}>{navLabels.faq}</a>
                    <a href={toggleHref} hreflang={toggleLang} lang={toggleLang}>{navLabels.toggleShort}</a>
                </nav>
            </header>
            <div class="wizard-shell__content">
                <slot />
            </div>
            <footer class="footer-shell footer-shell--wizard" aria-label={footer.ariaLabel} transition:name="site-footer">
                <div class="footer-container footer-container--wizard">
                    <div class="footer-brand" transition:name="site-footer-brand" transition:persist>
                        <Image
                            src={logo32}
                            alt=""
                            aria-hidden="true"
                            class="footer-logo"
                            width={24}
                            height={24}
                            densities={[1, 2]}
                            format="webp"
                        />
                        <span class="footer-title">{footer.brand}</span>
                    </div>
                    <p class="footer-tagline">{footer.tagline}</p>
                    <nav class="footer-links" aria-label={navLabels.navFooter}>
                        <a href={quickstartHref}>{navLabels.quickstart}</a>
                        <a href={faqHref}>{navLabels.faq}</a>
                        <a href="https://github.com/VetCoders/vibecrafted" rel="noopener noreferrer">{navLabels.github}</a>
                    </nav>
                    <p class="footer-copyright">{footer.copyright}</p>
                </div>
            </footer>
        </div>
    </main>
</body>
</html>

<style>
  html,
  body {
    margin: 0;
    min-height: 100dvh;
  }

  body.wizard-page {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(0.8rem, 2vw, 1.35rem);
    overflow: hidden;
    background: var(--stone-deep, #0e0e11);
  }

  body.wizard-page::before,
  body.wizard-page::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  body.wizard-page::before {
    background:
      radial-gradient(circle at 22% 18%, rgba(184, 115, 51, 0.16), transparent 28%),
      radial-gradient(circle at 78% 16%, rgba(90, 138, 122, 0.12), transparent 24%),
      radial-gradient(circle at 52% 82%, rgba(163, 184, 199, 0.08), transparent 30%);
    opacity: 0.95;
    mix-blend-mode: screen;
  }

  body.wizard-page::after {
    background:
      linear-gradient(180deg, rgba(7, 8, 10, 0.22), rgba(7, 8, 10, 0.72)),
      radial-gradient(circle at 50% 24%, transparent 30%, rgba(9, 10, 12, 0.62) 100%);
  }

  .wizard-shell {
    position: relative;
    z-index: 1;
    width: min(100%, 76rem);
    height: min(calc(100dvh - 1.6rem), 58rem);
    min-height: min(calc(100dvh - 1.6rem), 46rem);
  }

  .wizard-shell::before,
  .wizard-shell::after {
    content: "";
    position: absolute;
    pointer-events: none;
    border-radius: 999px;
    filter: blur(42px);
    opacity: 0.42;
  }

  .wizard-shell::before {
    width: 16rem;
    height: 16rem;
    top: -2rem;
    right: 8%;
    background: rgba(184, 115, 51, 0.22);
  }

  .wizard-shell::after {
    width: 14rem;
    height: 14rem;
    bottom: -2.5rem;
    left: 10%;
    background: rgba(90, 138, 122, 0.16);
  }

  .wizard-shell__frame {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    border: 1px solid rgba(196, 212, 224, 0.16);
    border-radius: clamp(1.4rem, 3vw, 2rem);
    background:
      linear-gradient(180deg, rgba(10, 12, 15, 0.92), rgba(8, 9, 12, 0.98)),
      radial-gradient(circle at top right, rgba(184, 115, 51, 0.12), transparent 34%);
    box-shadow:
      0 32px 80px rgba(0, 0, 0, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .wizard-shell__frame::before,
  .wizard-shell__frame::after {
    content: "";
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    height: 1px;
    pointer-events: none;
  }

  .wizard-shell__frame::before {
    top: 0;
    background: linear-gradient(90deg, rgba(184, 115, 51, 0), rgba(184, 115, 51, 0.58), rgba(163, 184, 199, 0.18), rgba(184, 115, 51, 0));
  }

  .wizard-shell__frame::after {
    bottom: 0;
    background: linear-gradient(90deg, rgba(163, 184, 199, 0), rgba(163, 184, 199, 0.2), rgba(184, 115, 51, 0.42), rgba(163, 184, 199, 0));
  }

  .wizard-shell__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1rem 0.65rem;
    border-bottom: 1px solid rgba(196, 212, 224, 0.12);
    background:
      linear-gradient(180deg, rgba(11, 13, 16, 0.9), rgba(10, 12, 15, 0.72)),
      radial-gradient(circle at top left, rgba(184, 115, 51, 0.12), transparent 36%);
    backdrop-filter: blur(18px) saturate(118%);
    -webkit-backdrop-filter: blur(18px) saturate(118%);
  }

  .wizard-shell__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem 0.8rem;
    align-items: center;
  }

  .wizard-shell__links a {
    color: rgba(229, 236, 245, 0.78);
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .wizard-shell__links a:hover,
  .wizard-shell__links a:focus-visible {
    color: var(--copper-bright, #d4905c);
    transform: translateY(-1px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--steel-edge);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: inherit;
    border-radius: 999px;
    padding: 0.18rem 0.35rem;
    box-shadow: var(--brand-mark-shadow);
    transition:
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.22s ease;
  }

  .brand:hover .brand-mark,
  .brand:focus-visible .brand-mark {
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(229, 236, 245, 0.24),
      0 12px 28px rgba(0, 0, 0, 0.2);
  }

  .brand-wordmark {
    color: var(--steel-edge);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .brand-logo {
    margin-left: 0;
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--steel-border-soft);
  }

  .wizard-shell__content {
    flex: 1;
    min-height: 0;
  }

  .footer-shell {
    width: 100%;
    margin: 0;
    padding: var(--footer-shell-padding);
    border: 0;
    border-radius: 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--footer-shell-gap);
    position: relative;
    overflow: visible;
    isolation: isolate;
    box-shadow: none;
  }

  .footer-shell--wizard {
    margin-top: 0;
    border-top: 1px solid rgba(196, 212, 224, 0.12);
    background:
      linear-gradient(180deg, rgba(10, 12, 15, 0.72), rgba(8, 9, 12, 0.92)),
      radial-gradient(circle at bottom right, rgba(90, 138, 122, 0.1), transparent 40%);
  }

  .footer-container--wizard {
    width: 100%;
    gap: 0.4rem;
    padding-block: 0.85rem;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.72rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    color: var(--steel-edge);
    font-family: var(--font-mono);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .footer-logo {
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--steel-border-soft);
  }

  .footer-title {
    color: var(--steel-edge);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .footer-tagline {
    margin: 0;
    max-width: 34rem;
    color: var(--steel-dark);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1.35;
    text-align: center;
    text-transform: none;
  }

  .footer-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--footer-links-gap);
    margin: 0;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: auto;
    padding: 0.15rem 0;
    color: var(--steel-dark);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 0.2s ease,
      transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
      text-shadow 0.18s ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--steel);
    transform: translateY(-1px);
    text-shadow: 0 0 14px rgba(163, 184, 199, 0.1);
  }

  .footer-copyright {
    margin: 0;
    color: var(--steel-dark);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    body.wizard-page {
      padding: 0;
    }

    .wizard-shell {
      width: 100%;
      height: 100dvh;
      min-height: 100dvh;
    }

    .wizard-shell__frame {
      border-left: 0;
      border-right: 0;
      border-radius: 0;
    }

    .wizard-shell__topbar {
      align-items: flex-start;
      padding: 0.9rem 0.95rem 0.6rem;
    }

    .wizard-shell__links {
      gap: 0.35rem 0.7rem;
    }

    .brand {
      gap: 0.45rem;
    }

    .brand-wordmark {
      font-size: 0.84rem;
      letter-spacing: 0.16em;
    }

    .footer-container--wizard {
      padding-inline: 0.95rem;
      padding-block: 0.72rem;
    }

    .footer-tagline {
      width: auto;
      padding: 0;
      margin-left: 0;
      border-left: 0;
      text-align: center;
      line-height: 1.5;
    }

    .footer-links {
      gap: 0.75rem 1rem;
      padding: 0 1rem;
    }
  }
</style>
