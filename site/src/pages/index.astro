---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const entry = await getEntry('pages', 'en/index');
if (!entry) {
  throw new Error("Content entry not found: en/index");
}
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description} lang="en">
    <Content />
</Layout>
