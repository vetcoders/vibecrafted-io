---
import { getEntry, render } from 'astro:content';
import NotFoundLocaleSwitch from '../components/NotFoundLocaleSwitch.svelte';
import Layout from '../layouts/Layout.astro';

const entryEn = await getEntry('pages', 'en/404');
const entryPl = await getEntry('pages', 'pl/404');
if (!entryEn || !entryPl) {
  throw new Error("Content entry not found: 404");
}
const { Content: ContentEn } = await render(entryEn);
const { Content: ContentPl } = await render(entryPl);
---

<Layout title={entryEn.data.title} description={entryEn.data.description} lang="en">
    <NotFoundLocaleSwitch client:load />
    <div id="not-found-en">
        <ContentEn />
    </div>
    <div id="not-found-pl" hidden>
        <ContentPl />
    </div>
</Layout>

<style is:global>
  html[lang='pl'] #not-found-en {
    display: none;
  }

  html[lang='pl'] #not-found-pl {
    display: block;
  }

  html[lang='en'] #not-found-en {
    display: block;
  }

  html[lang='en'] #not-found-pl {
    display: none;
  }
</style>
