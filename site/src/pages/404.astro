---
import { Picture } from 'astro:assets';
import logo32 from '../assets/presence/logo-32.png';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Route Not Found | Vibecrafted"
  description="The requested Vibecrafted page could not be found. Return home, open the quick start, or inspect the framework."
  lang="en"
>
  <section class="not-found-view">
    <div class="not-found-shell">
      <div class="not-found-grid">
        <div class="not-found-copy">
          <div class="not-found-eyebrow">
            <Picture
              src={logo32}
              alt=""
              aria-hidden="true"
              class="not-found-eyebrow__logo"
              width={28}
              height={28}
              densities={[1, 2]}
              formats={['avif', 'webp']}
            />
            <span>Route fracture detected</span>
          </div>

          <p class="section-label">Copper / Patina / Stone</p>
          <h1 class="not-found-title">404</h1>
          <p class="not-found-lead">
            This page slipped outside the known map. The framework is still intact, but this route does not resolve to
            a public surface.
          </p>

          <div class="not-found-actions">
            <a class="btn-solid" href="/">Back Home</a>
            <a class="btn-outline" href="/presence/quickstart/">Quick Start</a>
          </div>
        </div>

        <aside class="not-found-panel" aria-label="Recovery options">
          <p class="not-found-panel__kicker">Fast recovery</p>
          <ul class="not-found-links">
            <li><a href="/">Open the home page</a></li>
            <li><a href="/presence/framework/">View the framework demo</a></li>
            <li><a href="/presence/faq/">Check the FAQ</a></li>
            <li><a href="https://github.com/VetCoders/vibecrafted">Browse the repository</a></li>
          </ul>
          <p class="not-found-panel__note">
            If you followed an old link, jump back to the homepage and re-enter through the current navigation.
          </p>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found-view {
    min-height: calc(100svh - var(--chrome-offset));
    display: flex;
    align-items: center;
    padding: calc(var(--nav-height) + 3rem) 0 3rem;
  }

  .not-found-shell {
    width: var(--page-shell);
    margin: 0 auto;
  }

  .not-found-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 24rem);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: stretch;
  }

  .not-found-copy,
  .not-found-panel {
    position: relative;
    border: 1px solid var(--glass-panel-border);
    border-radius: calc(var(--radius-lg) + 4px);
    background:
      linear-gradient(180deg, rgba(23, 27, 31, 0.82), rgba(8, 10, 12, 0.94)),
      radial-gradient(circle at top left, rgba(184, 115, 51, 0.18), transparent 42%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 28px 60px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  .not-found-copy {
    padding: clamp(1.6rem, 4vw, 3rem);
  }

  .not-found-copy::after,
  .not-found-panel::after {
    content: "";
    position: absolute;
    inset: auto auto 0 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(184, 115, 51, 0), rgba(184, 115, 51, 0.65), rgba(127, 181, 163, 0));
  }

  .not-found-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid rgba(163, 184, 199, 0.18);
    border-radius: 999px;
    background: rgba(14, 14, 17, 0.46);
    color: var(--steel-edge);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .not-found-eyebrow__logo {
    border-radius: 8px;
    box-shadow: 0 0 0 1px rgba(163, 184, 199, 0.2);
  }

  .not-found-title {
    font-size: clamp(5rem, 18vw, 9rem);
    line-height: 0.88;
    letter-spacing: -0.08em;
    color: var(--stone-light);
    text-shadow: 0 18px 48px rgba(184, 115, 51, 0.2);
  }

  .not-found-lead {
    max-width: 32rem;
    margin-top: 1.25rem;
    color: rgba(229, 236, 245, 0.82);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.7;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.6rem;
  }

  .not-found-panel {
    padding: clamp(1.35rem, 3vw, 2rem);
  }

  .not-found-panel__kicker {
    color: var(--patina);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .not-found-links {
    list-style: none;
    display: grid;
    gap: 0.85rem;
    margin: 1.35rem 0 1.5rem;
    padding: 0;
  }

  .not-found-links a {
    display: block;
    min-height: 48px;
    padding: 0.95rem 1rem;
    border: 1px solid rgba(163, 184, 199, 0.14);
    border-radius: var(--radius-md);
    background: rgba(10, 11, 14, 0.58);
    color: var(--stone-light);
    font-family: var(--font-head);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }

  .not-found-links a:hover,
  .not-found-links a:focus-visible {
    border-color: rgba(184, 115, 51, 0.48);
    background: rgba(22, 25, 29, 0.82);
    transform: translateY(-1px);
    outline: none;
  }

  .not-found-panel__note {
    color: var(--steel-dark);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .not-found-view {
      min-height: auto;
      padding-top: calc(var(--nav-height) + 2rem);
    }

    .not-found-grid {
      grid-template-columns: 1fr;
    }

    .not-found-copy,
    .not-found-panel {
      padding: 1.35rem;
    }

    .not-found-title {
      font-size: clamp(4rem, 26vw, 6rem);
    }
  }
</style>
