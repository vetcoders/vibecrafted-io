---
import { loadCopy } from '../../lib/content';
import LayoutV2 from '../../layouts/LayoutV2.astro';
import SectionShell from '../../components/SectionShell.astro';
import PilotForm from '../../components/PilotForm.svelte';

const entry = { data: await loadCopy('pilot', 'en') };
if (!entry) throw new Error('Missing i18n entry: en/pilot-v2');

const section = entry.data as {
  title: string;
  centerLabel: string;
  pageTitle: string;
  pageDescription: string;
  headingHtml: string;
  lead: string;
  ref: string;
  back: string;
  backHref: string;
  emailPrefer: string;
  emailHref: string;
  emailLabel: string;
  submit: string;
  submitPay: string;
  localNote: string;
  stripeNote: string;
  noStripeNote: string;
  successTitle: string;
  successStripe: string;
  successStripeBlocked: string;
  successLocal: string;
  nextLabel: string;
  next: Array<{ title: string; body: string }>;
  fields: Record<string, string>;
  placeholders: Record<string, string>;
  moments: Array<{ value: string; label: string }>;
  errors: Record<string, string>;
};

const stripePaymentLink = import.meta.env.PUBLIC_STRIPE_PILOT_PAYMENT_LINK ?? '';
---

<LayoutV2
  title={section.pageTitle}
  description={section.pageDescription}
  lang="en"
  hasHero={false}
  hideNewsletter={true}
>
  <SectionShell
    number="09"
    title={section.title}
    centerLabel={section.centerLabel}
    figure="09 · PILOT"
    surface="ink"
    seam="none"
    id="pilot"
  >
    <div class="pilot">
      <a class="pilot__back" href={section.backHref}>{section.back}</a>
      <h1 class="pilot__heading">
        <Fragment set:html={section.headingHtml} />
        <span class="brand-dot">.</span>
      </h1>
      <p class="pilot__lead">{section.lead}</p>
      <p class="pilot__ref">{section.ref}</p>
      <p class="pilot__mail">
        {section.emailPrefer}
        <a href={section.emailHref}>{section.emailLabel}</a>
      </p>

      <PilotForm
        client:load
        fields={section.fields as any}
        placeholders={section.placeholders as any}
        moments={section.moments}
        errors={section.errors as any}
        submit={section.submit}
        submitPay={section.submitPay}
        localNote={section.localNote}
        stripeNote={section.stripeNote}
        noStripeNote={section.noStripeNote}
        successTitle={section.successTitle}
        successStripe={section.successStripe}
        successStripeBlocked={section.successStripeBlocked}
        successLocal={section.successLocal}
        nextLabel={section.nextLabel}
        next={section.next}
        stripePaymentLink={stripePaymentLink}
      />
    </div>
  </SectionShell>
</LayoutV2>

<style>
  .pilot {
    max-width: 46rem;
  }

  .pilot__back {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-on-dark-mute);
    text-decoration: none;
  }

  .pilot__back:hover {
    color: var(--accent);
  }

  .pilot__heading {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--fg-on-dark);
  }

  .pilot__heading :global(em.accent) {
    font-style: italic;
    color: var(--accent);
  }

  .pilot__lead {
    margin: 0 0 0.7rem;
    color: var(--fg-on-dark-dim);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .pilot__ref,
  .pilot__mail {
    margin: 0 0 0.85rem;
    color: var(--fg-on-dark-mute);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .pilot__mail a {
    color: var(--accent);
  }

  .pilot :global(.pf),
  .pilot :global(.pf-success) {
    margin-top: 1.75rem;
  }
</style>
