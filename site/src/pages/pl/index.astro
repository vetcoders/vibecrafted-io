---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entry = await getEntry('pages', 'pl/index');
if (!entry) {
  throw new Error("Content entry not found: pl/index");
}
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description} lang="pl">
    <Content />
</Layout>
