---
import LayoutV2 from '../../layouts/LayoutV2.astro';
import HeroSectionV2 from '../../components/sections/HeroSectionV2.svelte';
import SectionProductSurface from '../../components/sections/SectionProductSurface.astro';
import SectionProblem from '../../components/sections/SectionProblem.astro';
import SectionShift from '../../components/sections/SectionShift.astro';
import SectionFramework from '../../components/sections/SectionFramework.astro';
import SectionOperator from '../../components/sections/SectionOperator.astro';
import SectionInstallManifest from '../../components/sections/SectionInstallManifest.astro';
import SectionQuickstart from '../../components/sections/SectionQuickstart.astro';
import SectionReferences from '../../components/sections/SectionReferences.astro';
import SectionEvidence from '../../components/sections/SectionEvidence.astro';
import SectionCommercial from '../../components/sections/SectionCommercial.astro';
import SectionEngineering from '../../components/sections/SectionEngineering.astro';
import { getTranslations } from '../../lib/i18n';
import { loadCopy } from '../../lib/content';
import type { HeroData } from '../../components/sections/HeroSectionV2.svelte';

const t = getTranslations('pl');
const page = t.v2Pages.landing;
const hero = (await loadCopy('hero', 'pl')) as unknown as HeroData;
---

<LayoutV2
  title={page.title}
  description={page.description}
  lang="pl"
  hasHero={true}
  ogImage="/assets/product/02-start-here-map.png"
>
  <HeroSectionV2 client:load lang="pl" hero={hero} />
  <SectionProductSurface lang="pl" />
  <SectionInstallManifest lang="pl" />
  <SectionProblem lang="pl" />
  <SectionEngineering lang="pl" />
  <SectionShift lang="pl" />
  <SectionFramework lang="pl" />
  <SectionOperator lang="pl" />
  <SectionQuickstart lang="pl" />
  <SectionReferences lang="pl" />
  <SectionEvidence lang="pl" />
  <SectionCommercial lang="pl" />
</LayoutV2>
