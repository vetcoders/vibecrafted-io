# Vibecrafted contact mailer — environment.
# Copy to a secure path on libraxis-vm (e.g. /etc/vibecrafted/contact.env, chmod 600)
# and fill in the real key. NEVER commit the real key.

# Resend API key — create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact submissions land:
CONTACT_TO=hello@vibecrafted.io

# Sender — the domain MUST be verified in Resend (https://resend.com/domains).
# Until vibecrafted.io is verified you can test with: onboarding@resend.dev
CONTACT_FROM=Vibecrafted <hello@vibecrafted.io>

# Local bind — Caddy reverse-proxies /api/contact to this. Keep it on loopback.
HOST=127.0.0.1
PORT=8787
