# Required for `make foundations-release` (notarized full path).
# Copy to .env.foundations and fill in your values, then run:
# source .env.foundations

# Apple notarization (loctree-suite + aicx)
export MACOS_DEVELOPER_ID_APPLICATION="Developer ID Application: Your Name (TEAMID)"
export APPLE_ID="your-apple-id@example.com"
export APPLE_TEAM_ID="ABCDE12345"
export APPLE_APP_SPECIFIC_PASSWORD="abcd-efgh-ijkl-mnop"

# aicx-specific local release inputs.
export KEYS="$HOME/.keys"
export NOTARY_PROFILE="my-notary-profile"
